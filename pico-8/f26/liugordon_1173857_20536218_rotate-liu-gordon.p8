pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

n=16 -- grid is n x n tiles
ts=8 -- tile size in px
sz=n*ts -- pixel size of the whole grid (128)

empty=0
block=1
spike=2
door=3

pw,ph=6,6 -- player hitbox
grav=0.25
maxfall=3
spd=2

function make_grid()
 local g={}
 for y=0,n-1 do
  g[y]={}
  for x=0,n-1 do
   g[y][x]=empty
  end
 end
 return g
end

level_defs={
 {0,0}, 
 {16,0},
 {32,0},
 {48,0},
 {64,0},
 {80,0},
 {96,0},
}
num_levels=#level_defs

function parse_level(ox,oy)
 local g=make_grid()
 local sx,sy=3*ts+1,3*ts
 for y=0,n-1 do
  for x=0,n-1 do
   local s=mget(ox+x,oy+y)
   if s==1 then g[y][x]=block
   elseif s==2 then g[y][x]=spike
   elseif s==3 then g[y][x]=door
   elseif s==4 then
    sx=x*ts+1
    sy=y*ts
   end
  end
 end
 return g,sx,sy
end

grid=nil
cur_level=1
px,py=0,0
vx,vy=0,0
alive=true
won=false
prev_z=false
prev_x=false

function start_level(i)
 cur_level=i
 local ox,oy=level_defs[i][1],level_defs[i][2]
 local g,sx,sy=parse_level(ox,oy)
 grid=g
 px,py=sx,sy
 vx,vy=0,0
 alive=true
 won=false
end

function _init()
 start_level(1)
end

function tileat(gx,gy)
 if gx<0 or gx>=n or gy<0 or gy>=n then return block end
 return grid[gy][gx]
end

function solid(gx,gy) return tileat(gx,gy)==block end
function is_spike(gx,gy) return tileat(gx,gy)==spike end
function is_door(gx,gy) return tileat(gx,gy)==door end

function rotate_grid_cw()
 local ng=make_grid()
 for y=0,n-1 do
  for x=0,n-1 do
   ng[y][x]=grid[n-1-x][y]
  end
 end
 grid=ng
end

function rotate_grid_ccw()
 local ng=make_grid()
 for y=0,n-1 do
  for x=0,n-1 do
   ng[y][x]=grid[x][n-1-y]
  end
 end
 grid=ng
end

function clamp_player()
 if px<0 then px=0 end
 if px>sz-pw then px=sz-pw end
 if py<0 then py=0 end
 if py>sz-ph then py=sz-ph end
end

function rotate_player_cw()
 local cx,cy=px+pw/2,py+ph/2
 local ncx,ncy=sz-cy,cx
 px,py=ncx-pw/2,ncy-ph/2
 vx,vy=-vy,vx
 clamp_player()
end

function rotate_player_ccw()
 local cx,cy=px+pw/2,py+ph/2
 local ncx,ncy=cy,sz-cx
 px,py=ncx-pw/2,ncy-ph/2
 vx,vy=vy,-vx
 clamp_player()
end

function do_rotate_cw()
 rotate_grid_cw()
 rotate_player_cw()
end

function do_rotate_ccw()
 rotate_grid_ccw()
 rotate_player_ccw()
end

function move_x(dx)
 local nx=px+dx
 local gy1=flr(py/ts)
 local gy2=flr((py+ph-1)/ts)
 if dx>0 then
  local gx=flr((nx+pw-1)/ts)
  if solid(gx,gy1) or solid(gx,gy2) then
   nx=gx*ts-pw
   vx=0
  end
 elseif dx<0 then
  local gx=flr(nx/ts)
  if solid(gx,gy1) or solid(gx,gy2) then
   nx=(gx+1)*ts
   vx=0
  end
 end
 px=nx
end

function move_y(dy)
 local ny=py+dy
 local gx1=flr(px/ts)
 local gx2=flr((px+pw-1)/ts)
 if dy>0 then
  local gy=flr((ny+ph-1)/ts)
  if solid(gx1,gy) or solid(gx2,gy) then
   ny=gy*ts-ph
   vy=0
  end
 elseif dy<0 then
  local gy=flr(ny/ts)
  if solid(gx1,gy) or solid(gx2,gy) then
   ny=(gy+1)*ts
   vy=0
  end
 end
 py=ny
end

function check_hazard_and_door()
 local corners={
  {px,py},{px+pw-1,py},
  {px,py+ph-1},{px+pw-1,py+ph-1}
 }
 for c in all(corners) do
  local gx,gy=flr(c[1]/ts),flr(c[2]/ts)
  if is_spike(gx,gy) then alive=false end
  if is_door(gx,gy) then won=true end
 end
end

function _update()
 local zdown=btn(4)
 local xdown=btn(5)
 local z_pressed=zdown and not prev_z
 local x_pressed=xdown and not prev_x
 prev_z=zdown
 prev_x=xdown

 if not alive or won then
  if z_pressed or x_pressed then
   if won then
    start_level(cur_level%num_levels+1)
   else
    start_level(cur_level)
   end
  end
  return
 end

 if z_pressed then do_rotate_ccw() end -- z / o button: rotate left
 if x_pressed then do_rotate_cw()  end -- x button: rotate right

 if btn(0) then vx=-spd
 elseif btn(1) then vx=spd
 else vx*=0.7
 end

 vy=min(vy+grav,maxfall)

 move_x(vx)
 move_y(vy)

 check_hazard_and_door()
end

function _draw()
 cls(1)
 for y=0,n-1 do
  for x=0,n-1 do
   local t=grid[y][x]
   if t==block then
    rectfill(x*ts,y*ts,x*ts+ts-1,y*ts+ts-1,5)
   elseif t==spike then
    rectfill(x*ts,y*ts,x*ts+ts-1,y*ts+ts-1,1)
    line(x*ts,y*ts+ts-1,x*ts+ts/2,y*ts,8)
    line(x*ts+ts/2,y*ts,x*ts+ts-1,y*ts+ts-1,8)
   elseif t==door then
    rectfill(x*ts,y*ts,x*ts+ts-1,y*ts+ts-1,11)
   end
  end
 end

 if alive then
  rectfill(px,py,px+pw-1,py+ph-1,7)
 end

 print("lvl "..cur_level.."/"..num_levels,2,2,6)

 if not alive then
  print("you died - z/x to retry",8,60,8)
 end
 if won then
  print("you win! - z/x for next",8,60,11)
 end
end
