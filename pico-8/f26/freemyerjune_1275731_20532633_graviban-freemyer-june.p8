pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	gravity = { x = 0, y = 1 }
	last_input = -1
    level = 1
    levelx = (level - 1) * 16
    levely = 0
    max_levels = 4
	won = false
    moved = true
    map_data = read_map(levelx, levely)
    map_data_constants = read_map_data_constants(map_data, levelx, levely)
end

function _update()
    levelx = (level - 1) * 16
    levely = 0
    map_data = read_map(levelx, levely)
	local input = -1
    if moved == false then
	    if btn(0) then input = 0 gravity = { x = -1, y = 0 }end
	    if btn(1) then input = 1 gravity = { x = 1, y = 0 }end
	    if btn(2) then input = 2 gravity = { x = 0, y = -1 }end
	    if btn(3) then input = 3 gravity = { x = 0, y = 1 }end
    end
	move_blocks(map_data, levelx, levely)
    if btn(4) or btn(5) then reload_level() end
	last_input = input

    if check_win_condition(map_data, levelx, levely) then
        if level < max_levels then
            level += 1
            levelx = (level - 1) * 16
            levely = 0
	        gravity = { x = 0, y = 1 }
            map_data = read_map(levelx, levely)
            map_data_constants = read_map_data_constants(map_data, levelx, levely)
            moved = true
        else
            won = true
        end
    end

end

function _draw()
	cls(0)
    map(levelx, levely, 0, 0, 16, 16)
    if level == 1 then
        print("⬅️/⬆️/⬇️/➡️ : change gravity", 8, 30, 7)
        print("🅾️/❎ : reset level", 32, 40, 7)
        print("get all stars into", 14, 50, 7)
        print("boxes to win", 14, 60, 7)
    end
    if won then
        rectfill(30, 50, 120, 80, 0)
        print("a winner is you!", 40, 60, 7)
    end
end

function read_map(xpos, ypos)
    local map_data = {}
    for y=ypos,ypos+15 do
        map_data[y] = {}
        for x=xpos,xpos+15 do
            local tile = mget(x,y)
            map_data[y][x] = tile
        end
    end
    return map_data
end

function read_map_data_constants(map_data, xpos, ypos)
    local constants = {}
    for y=ypos,ypos+15 do
        constants[y] = {}
        for x=xpos,xpos+15 do
            local tile = map_data[y][x]
            if tile >=6 and tile <=9 then
                constants[y][x] = tile
            else
                constants[y][x] = 0
            end
        end
    end
    return constants
end

function check_win_condition(map_data, xpos, ypos)
    for y=ypos,ypos+15 do
        for x=xpos,xpos+15 do
            local tile = map_data[y][x]
            if tile == 1 or tile == 2 then -- block or goal still exists, not won yet
                return false 
            end
        end
    end
    return true -- no blocks left, player has won
end

function reload_level()
    reload(0x2000, 0x2000, 0x1000)
    levelx = (level - 1) * 16
    levely = 0
    map_data = read_map(levelx, levely)
    map_data_constants = read_map_data_constants(map_data, levelx, levely)
	gravity = { x = 0, y = 1 }
    won = false
    moved = true
end

function move_blocks(map_data, xpos, ypos)
    moved = false
    for y=ypos,ypos+15 do
        for x=xpos,xpos+15 do
            local tile = map_data[y][x]
            if tile == 2 then -- block
                local new_x = x + gravity.x
                local new_y = y + gravity.y
                if can_move_to(new_x, new_y, map_data) then
                    if(map_data[new_y][new_x] == 1) then
                        -- block has reached the exit
                        mset(x, y, map_data_constants[y][x]) -- clear old position
                        mset(new_x, new_y, 3) -- lock block in exit position
                        moved = true
                    elseif (map_data[new_y][new_x] == 5) then
                        -- block has reached a danger block
                        mset(x, y, map_data_constants[y][x]) -- clear old position
                        mset(new_x, new_y, 4) -- danger block is deactivated
                        moved = true
                    else
                        mset(x, y, map_data_constants[y][x]) -- clear old position
                        mset(new_x, new_y, 2) -- set new position
                        moved = true
                    end
                    moved = true
                end
            end
        end
    end


end

function can_move_to(x, y, map_data)
    if x < levelx or x > levelx + 15 or y < levely or y > levely + 15 then
        return false
    end
    local tile = map_data[y][x]
    if(tile >= 6 and tile <=9 ) then
        if(tile == 6 and gravity.y !=-1) then return false end
        if(tile == 7 and gravity.x !=-1) then return false end
        if(tile == 8 and gravity.y !=1) then return false end
        if(tile == 9 and gravity.x !=1) then return false end
        return true
    end
    return (tile == 0) or (tile == 1) or (tile == 5)-- can move to empty space, goal, or danger block
    
end

