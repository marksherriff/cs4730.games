pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--main

-- cheats
cheat_fly=false
cheat_coords=false
cheat_slow=false
cheat_sprint=false

slowdown=16
slow=0

player_x=05
player_y=61

sprint_enabled=cheat_sprint

dx=0
dy=0

on_ground=false

message=""
message_time=0
message_color=7

gravity=1
gravity_step=0.05685

function _init()
end

function _update()
	if cheat_slow then
		slow=(slow+1)%slowdown
		if slow!=0 then	
			return
		end
	end
	
	if player_y<-76 then
		gravity_step=0.04
	else
		gravity_step=0.05685
	end
	
	handle_gravity()	
	handle_controls()
	update_position()
	trigger_messages()
end

function _draw()
	cls(0)
	
	-- draw map slices
	for i=0,5,1 do
		map(22*i,0,59-player_x*8,59-player_y*8-64*8*i,22)
	end
	spr(1,59,59)
	
	print("⬅️➡️=move\n❎/x=jump\n🅾️/z="..(sprint_enabled and "sprint" or "????"),59-player_x*8+11*8-60,59-player_y*8+65*8-6,7)
	
	-- draw messages
	if message_time>0 then
		draw_message()
		message_time-=1
	end
	
	-- display coords if enabled
	if cheat_coords then
		map_x,map_y=p2m(player_x,player_y)
		print("p:\n"..
								player_x.."\n"..
								player_y.."\n"..
								"m:\n"..
								map_x.."\n"..
								map_y.."\n",0,0)
	end
	if cheat_fly then
		print("flight enabled",71,0,14)
	end
end
-->8
-- controls

function handle_controls()
	max_speed=sprint_enabled and
											btn(🅾️)
											and 0.5 or 0.375
	target_speed=0
	
	if btn(⬅️) then
		target_speed=-max_speed
	elseif btn(➡️) then
		target_speed=max_speed
	end
	
	dx+=(target_speed-dx)/2
	
	if btnp(❎) and 
				(on_ground or cheat_fly) then
			dy=-0.5
			sfx(01)
	end
end

function handle_gravity()
	on_ground=cc(player_x,player_y+0.125,2) or
											cc(player_x,player_y+0.125,3)
	if not on_ground and dy<gravity then
		dy+=gravity_step
	end
end

-->8
-- collision

function solid(x,y)
	x=flr(x)
	y=flr(y)
	return fget(mget(x,y),0)
end

function cc(x,y,corner)
	if corner==1 or corner==2 then
		x+=0.875
	end
	
	if corner==2 or corner==3 then
		y+=0.875
	end
	
	x,y=p2m(x,y)
	
	return solid(x,y)
end

function collision(x,y)	
	return cc(x,y,0) or
								cc(x,y,1) or
								cc(x,y,2) or
								cc(x,y,3)
end

function update_position()
	xstep=dx>0 and 0.125 or -0.125
	for x=player_x,player_x+dx,xstep do
		if collision(x,player_y) then
			break
		end
		player_x=x
	end
	ystep=dy>0 and 0.125 or -0.125
	for y=player_y,player_y+dy,ystep do
		if collision(player_x,y) then
			if dy>=gravity then
				sfx(02)
			end
			dy=dy>0 and 0 or dy
			break
		end
		player_y=y
	end
end
-->8
-- message drawing

function draw_message_box()
	spr(16,0,95)
	spr(32,0,103)
	spr(32,0,111)
	spr(48,0,119)
	for i=1,14 do
		spr(17,i*8,95)
	end
	for i=1,14 do
		spr(33,i*8,103)
	end
	for i=1,14 do
		spr(33,i*8,111)
	end
	for i=1,14 do
		spr(49,i*8,119)
	end
	spr(18,119,95)
	spr(34,119,103)
	spr(34,119,111)
	spr(50,119,119)	
end

function draw_message()
	draw_message_box()
	print(message,7,100,message_color)
end
-->8
-- events

shown_born=false
shown_insult_1=false
shown_fall=false
shown_second_try=false
shown_insult_2=false
shown_easy=false
shown_hard=false
shown_rhythm=false
shown_hurt=false
shown_nomatter=false
shown_end=false

function trigger(x,y)
	map_x,map_y=p2m(player_x,player_y)
	return (flr(map_x)==x or ceil(map_x)==x) and
								(flr(map_y)==y or ceil(map_y)==y)
end

function trigger_messages()
	if time() == 2 then
		message="i hate being down here"
		message_time=150
		message_color=7
		sfx(03)
	end
	if not shown_born and
				trigger(8,43) then
		
		sfx(03)
		message="everyone else seems to be\nnaturally just where they\nbelong"
		message_time=200
		message_color=7
		shown_born=true
	end
	
	if not shown_insult_1 and
				trigger(20,26) then
			
		message="no matter how far you climb\nyou'll always belong at the\nbottom"
		message_time=200
		shown_insult_1=true
		message_color=8
		
		mset(20,26,0)
		mset(14,28,7)
		mset(16,27,7)
		mset(15,29,0)
		mset(17,28,0)
		mset(21,26,6)
		mset(20,24,19)
		mset(21,24,5)
		mset(20,23,13)
		sfx(0)
	end
	
	if not shown_fall and
				shown_insult_1 and
				message_time==0 then
		
		sfx(03)
		message="sometimes the others try to\nstop me from climbing"
		message_time=150
		message_color=7
		shown_fall=true
	end
	
	if shown_fall and
				not shown_second_try and
				player_y<26 then
		sfx(03)
		message="they insist that everyone's\ngravity pulls them to where\nthey're supposed to be"
		message_time=200
		message_color=7
		shown_second_try=true
	end
	
	if not sprint_enabled and
								(trigger(5,20) or
									trigger(6,20) or
									trigger(7,20)) then
		message="sometimes to move forward i\nhave to learn new things\nabout myself"
		message_time=200
		message_color=7
		sfx(03)
		sprint_enabled=true
	end
	
	if not shown_easy and 
				trigger(9,12) then
				
		message="it seems so easy for the\nothers, never having to fight\ngravity"
		message_time=250
		message_color=7
		sfx(03)
		shown_easy=true
	end
	
	if not shown_journey and
				trigger(27,62) then
				
		message="but they'll also never get to\nexperience the journey i've\nbeen on"
		message_time=200
		message_color=7
		sfx(03)
		shown_journey=true
	end
	
	if not shown_hard and
				trigger(25,38) then
		message="and it's not always hard"
		message_time=150
		message_color=7
		sfx(03)
		shown_hard=true
	end
	
	if not shown_rhythm and
				trigger(23,20) then
		message="sometimes you can just get\ninto the rhythm of climbing"
		message_time=150
		message_color=7
		sfx(03)
		shown_rhythm=true
	end
	
	if not shown_hurt and
				trigger(25,03) then
		message="and the insults stop\nmaking you feel so down"
	 message_time=150
	 message_color=7
	 sfx(03)
	 shown_hurt=true
	 mset(25,03,0)
	 mset(27,03,7)
 end
 
 if not shown_nomatter and
 			(trigger(47,51) or
 				trigger(48,51) or
 				trigger(49,51)) then
 	message="because no matter what anyone\nsays"
 	message_time=150
 	message_color=7
 	sfx(03)
 	shown_nomatter=true
 end
 
 if not shown_end and
 			(trigger(60,51) or
 				trigger(61,51) or
 				trigger(62,51) or
 				trigger(63,51)) then
  message="you're the one who beat\ngravity"
  message_time=500
  message_color=14
  shown_end=true
  cheat_fly=true
  sfx(04)
  mset(50,52,0)
  mset(51,52,0)
  mset(58,52,0)
  mset(59,52,0)
 end
end
-->8
-- map transformation

function p2m(x,y)
	map_x=x+22*flr((64-y-0.125)/64)
	map_y=(64-((64-y)%64))%64
	return map_x,map_y
end
