pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
pal({[0]=0,5,6,7,128,133,134,4,132,15,142,143,9,10,137,130},1)

player_x=64
player_y=64
player_vx=0
player_vy=0
can_jump=false
jump_power=3
player_facing=1
player_sprite=0

projectiles={}
projectile_interval=30
projectile_timer=0
spawn_rate=0.5

collectibles={}
collectible_timer=0
collectible_next=180
collectible_sprite=17

points=0
high_score=0

difficulty_timer=0
difficulty_interval=600

projectile_sprites={16,32,33,34,35,48,49}
projectile_radius=3

gravity_modes={
    {x=0,y=0.15},
    {x=0,y=-0.15},
    {x=-0.15,y=0},
    {x=0.15,y=0}
}
current_track=1
gravity_timer=0
gravity_next=0

survival_time=0
game_over=false
game_state="menu"

player_sprites={
    [1]={[1]=0,[3]=4},
    [2]={[2]=1,[4]=5},
    [3]={[1]=6,[3]=2},
    [4]={[2]=7,[4]=3},
}

function sign(n)
    if n>=0 then return 1 else return -1 end
end

function solid_at(px,py)
    local tx=flr(px/8)
    local ty=flr(py/8)
    if tx<0 or tx>15 or ty<0 or ty>15 then return true end
    return mget(tx,ty)>=64 and mget(tx,ty)<=127
end

function pick_new_gravity()
    local new_track=current_track
    while new_track==current_track do
        new_track=flr(rnd(#gravity_modes))+1
    end
    return new_track
end

function find_collectible_spot()
    for attempt=1,40 do
        local cx=8+rnd(112)
        local cy=8+rnd(112)
        if not solid_at(cx,cy) then return cx,cy end
    end
    return nil,nil
end

function spawn_projectile()
    local sprite=projectile_sprites[flr(rnd(#projectile_sprites))+1]
    local speed=1+rnd(1)*spawn_rate
    local edge=flr(rnd(4))
    local bx,by,bvx,bvy

    if edge==0 then
        bx=rnd(128); by=-8
        bvx=(rnd(2)-1)*0.5
        bvy=speed
    elseif edge==1 then
        bx=rnd(128); by=136
        bvx=(rnd(2)-1)*0.5
        bvy=-speed
    elseif edge==2 then
        bx=-8; by=rnd(128)
        bvx=speed
        bvy=(rnd(2)-1)*0.5
    else
        bx=136; by=rnd(128)
        bvx=-speed
        bvy=(rnd(2)-1)*0.5
    end

    add(projectiles,{sprite=sprite,x=bx,y=by,vx=bvx,vy=bvy,life=400})
end

function _init()
    player_x=64
    player_y=124
    while player_y>8 and solid_at(player_x,player_y+4) do
        player_y-=8
    end

    player_vx=0
    player_vy=0
    can_jump=false
    player_facing=1
    player_sprite=0
    projectiles={}
    projectile_timer=0
    projectile_interval=30
    spawn_rate=0.5
    collectibles={}
    collectible_timer=0
    collectible_next=180
    points=0
    difficulty_timer=0
    current_track=1
    gravity_timer=0
    gravity_next=90+flr(rnd(211))
    survival_time=0
    game_over=false
    game_state="menu"
    music(0,0,2)
end

function _update()
    if game_state=="menu" then
        if btnp(4) or btnp(5) then game_state="playing" end
        return
    end

    if game_over then
        music(-1)
        if btnp(4) then _init() end
        return
    end

    survival_time+=1

    if survival_time%30==0 then points+=10 end

    difficulty_timer+=1
    if difficulty_timer>=difficulty_interval then
        difficulty_timer=0
        spawn_rate+=0.2
        if projectile_interval>8 then
            projectile_interval-=2
        else
            projectile_interval=8
        end
    end

    gravity_timer+=1
    if gravity_timer>=gravity_next then
        gravity_timer=0
        current_track=pick_new_gravity()
        gravity_next=90+flr(rnd(211))
    end

    local g=gravity_modes[current_track]
    local vertical_gravity=(g.y~=0)

    if vertical_gravity then
        if btn(0) then player_vx-=0.3 end
        if btn(1) then player_vx+=0.3 end
    else
        if btn(2) then player_vy-=0.3 end
        if btn(3) then player_vy+=0.3 end
    end

    if btnp(4) and can_jump then
        if vertical_gravity then
            player_vy=-sign(g.y)*jump_power
        else
            player_vx=-sign(g.x)*jump_power
        end
        can_jump=false
    end

    player_vx+=g.x
    player_vy+=g.y
    player_vx*=0.9
    player_vy*=0.98

    if vertical_gravity then
        local new_y=player_y+player_vy
        if solid_at(player_x-4,new_y-4) or solid_at(player_x+3,new_y-4)
        or solid_at(player_x-4,new_y+3) or solid_at(player_x+3,new_y+3) then
            player_vy=0
        else
            player_y=new_y
        end
        local new_x=player_x+player_vx
        if solid_at(new_x-4,player_y-4) or solid_at(new_x+3,player_y-4)
        or solid_at(new_x-4,player_y+3) or solid_at(new_x+3,player_y+3) then
            player_vx=0
        else
            player_x=new_x
        end
    else
        local new_x=player_x+player_vx
        if solid_at(new_x-4,player_y-4) or solid_at(new_x+3,player_y-4)
        or solid_at(new_x-4,player_y+3) or solid_at(new_x+3,player_y+3) then
            player_vx=0
        else
            player_x=new_x
        end
        local new_y=player_y+player_vy
        if solid_at(player_x-4,new_y-4) or solid_at(player_x+3,new_y-4)
        or solid_at(player_x-4,new_y+3) or solid_at(player_x+3,new_y+3) then
            player_vy=0
        else
            player_y=new_y
        end
    end

    if solid_at(player_x,player_y) then
        if not solid_at(player_x+4,player_y) then player_x+=4
        elseif not solid_at(player_x-4,player_y) then player_x-=4
        elseif not solid_at(player_x,player_y+4) then player_y+=4
        elseif not solid_at(player_x,player_y-4) then player_y-=4
        end
    end

    can_jump=false
    if g.y>0 and solid_at(player_x,player_y+4) then can_jump=true end
    if g.y<0 and solid_at(player_x,player_y-5) then can_jump=true end
    if g.x>0 and solid_at(player_x+4,player_y) then can_jump=true end
    if g.x<0 and solid_at(player_x-5,player_y) then can_jump=true end

    local surface
    if     g.y>0 then surface=1
    elseif g.x<0 then surface=2
    elseif g.y<0 then surface=3
    elseif g.x>0 then surface=4
    end

    local facing=player_facing
    if surface==1 or surface==3 then
        if     player_vx>0.3  then facing=1
        elseif player_vx<-0.3 then facing=3
        end
        if facing~=1 and facing~=3 then facing=1 end
    else
        if     player_vy>0.3  then facing=2
        elseif player_vy<-0.3 then facing=4
        end
        if facing~=2 and facing~=4 then facing=2 end
    end
    player_facing=facing
    player_sprite=player_sprites[surface][facing]

    collectible_timer+=1
    if collectible_timer>=collectible_next then
        collectible_timer=0
        collectible_next=90+flr(rnd(91))
        local cx,cy=find_collectible_spot()
        if cx then add(collectibles,{x=cx,y=cy,life=600}) end
    end

    for c in all(collectibles) do
        c.life-=1
        if abs(c.x-player_x)<6 and abs(c.y-player_y)<6 then
            points+=100
            del(collectibles,c)
        elseif c.life<=0 then
            del(collectibles,c)
        end
    end

    projectile_timer+=1
    if projectile_timer>=projectile_interval then
        projectile_timer=0
        spawn_projectile()
    end

    for p in all(projectiles) do
        p.x+=p.vx
        p.y+=p.vy
        p.life-=1

        local dx=p.x-player_x
        local dy=p.y-player_y
        if dx*dx+dy*dy < (projectile_radius+4)*(projectile_radius+4) then
            game_over=true
            if points>high_score then high_score=points end
        end

        if p.x<-16 or p.x>144 or p.y<-16 or p.y>144 or p.life<=0 then
            del(projectiles,p)
        end
    end
end

function _draw()
    cls(0)

    if game_state=="menu" then
        print("gravikitty",36,4,3)

        print("avoid:",4,20,3)
        spr(32,8,30)
        spr(33,20,30)
        spr(48,32,30)
        spr(49,44,30)
        spr(34,8,42)
        spr(35,20,42)
        spr(16,8,54)

        print("collect:",78,20,3)
        spr(collectible_sprite,78,30)
        print("+100",90,32,3)
        print("+10/sec",78,42,3)

        print("controls:",4,68,3)
        print("arrows: move",4,78,3)
        print("x: jump",4,88,3)

        print("press x to start",28,110,3)
        return
    end

    if game_over then
        cls(0)
        print("game over",44,30,3)
        print("time: "..flr(survival_time/30).."s",44,50,3)
        print("score: "..points,44,62,3)
        print("high score: "..high_score,32,74,3)
        print("press x to retry",30,100,3)
        return
    end

    map(0,0,0,0,16,16)

    for c in all(collectibles) do
        spr(collectible_sprite,c.x-4,c.y-4)
    end

    for p in all(projectiles) do
        spr(p.sprite,p.x-4,p.y-4)
    end

    spr(player_sprite,player_x-4,player_y-4)

    print("time: "..flr(survival_time/30),2,10,0)
    print("score: "..points,75,10,0)
end
