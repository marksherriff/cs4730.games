pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
level_count=8
level_width=16
level_height=13
wall_tile=1
node_first=2
node_last=4
seat_first=5
seat_last=7
hazard_tile=8
hazard_wall_tile=9

function _init()
 mode="title"
 level_index=1
 people={}
 seats={}
 hazards={}
 hazard_walls={}
 crown=1
 selected=1
 walls={}
 transfer_flash=0
 level_frames=1800
 total_frames=0
 final_frames=0
 menu_choice=1
 select_level=1
 run_mode="full"
 clear_level=1
 clear_frames=0
 poke(0x5f2d,1)
end

function start_game()
 run_mode="full"
 total_frames=0
 final_frames=0
 load_level(1)
end

function start_selected_level()
 run_mode="select"
 total_frames=0
 clear_frames=0
 load_level(select_level)
end

function change_selected_level(amount)
 select_level=((select_level-1+amount)%level_count)+1
end

function format_time(frames)
 local tenths=flr(frames/6)
 return flr(tenths/10).."."..
  (tenths%10).."s"
end

function make_person(pos)
 return {
  x=pos[1],y=pos[2],
  vx=0,vy=0,r=4,seated=false
 }
end

function load_level(n)
 level_index=n
 people={}
 seats={}
 hazards={}
 hazard_walls={}
 walls={}
 local slot=n-1
 local ox=(slot%8)*level_width
 local oy=flr(slot/8)*16
 for my=0,level_height-1 do
  for mx=0,level_width-1 do
   local tile=mget(ox+mx,oy+my)
   local x=mx*8+4
   local y=my*8+20
   if tile==wall_tile then
    add(walls,{x-4,y-4,x+3,y+3})
   elseif tile>=node_first
   and tile<=node_last then
    people[tile-node_first+1]=
     make_person({x,y})
   elseif tile>=seat_first
   and tile<=seat_last then
    seats[tile-seat_first+1]={x=x,y=y}
   elseif tile==hazard_tile then
    add(hazards,make_person({x,y}))
   elseif tile==hazard_wall_tile then
    add(hazard_walls,{x-4,y-4,x+3,y+3})
   end
  end
 end
 crown=1
 selected=1
 transfer_flash=0
 level_frames=1800
 mode="play"
end

function remaining_nodes()
 local count=0
 for i=1,#people do
  if not people[i].seated then
   count=count+1
  end
 end
 return count
end

function all_seated()
 return remaining_nodes()==0
end

function clamp_speed(p,limit)
 local speed=sqrt(p.vx*p.vx+p.vy*p.vy)
 if speed>limit then
  p.vx=p.vx/speed*limit
  p.vy=p.vy/speed*limit
 end
end

function hits_wall(p,x,y)
 for i=1,#walls do
  local w=walls[i]
  if x+p.r>w[1] and x-p.r<w[3]
  and y+p.r>w[2] and y-p.r<w[4] then
   return true
  end
 end
 return false
end

function move_person(p)
 local nx=p.x+p.vx
 if nx-p.r<5 or nx+p.r>122
 or hits_wall(p,nx,p.y) then
  p.vx=0
 else
  p.x=nx
 end

 local ny=p.y+p.vy
 if ny-p.r<15 or ny+p.r>116
 or hits_wall(p,p.x,ny) then
  p.vy=0
 else
  p.y=ny
 end
end

function touching(a,b)
 local dx=a.x-b.x
 local dy=a.y-b.y
 local reach=a.r+b.r
 return dx*dx+dy*dy<=reach*reach
end

function touches_hazard_wall(p)
 for i=1,#hazard_walls do
  local w=hazard_walls[i]
  if p.x+p.r>w[1] and p.x-p.r<w[3]
  and p.y+p.r>w[2] and p.y-p.r<w[4] then
   return true
  end
 end
 return false
end

function pull_toward(p,wearer,force,limit)
 local dx=wearer.x-p.x
 local dy=wearer.y-p.y
 local dist=sqrt(dx*dx+dy*dy)
 if dist>0 then
  p.vx=(p.vx+dx/dist*force)*0.99
  p.vy=(p.vy+dy/dist*force)*0.99
 end
 clamp_speed(p,limit)
 move_person(p)
end

function inside_seat(i)
 local p=people[i]
 local s=seats[i]
 local dx=p.x-s.x
 local dy=p.y-s.y
 return dx*dx+dy*dy<=64
end

function transfer_to(i)
 if transfer_flash>0 or i==crown
 or i<1 or i>#people then
  return false
 end
 crown=i
 selected=i
 people[i].vx=0
 people[i].vy=0
 if inside_seat(i) then
  people[i].seated=true
 end
 transfer_flash=6
 return true
end

function handle_number_key(key)
 local n=tonum(key)
 if n and n>=1 and n<=#people then
  selected=n
  transfer_to(n)
 end
end

function cycle_selection(direction)
 selected=selected+direction
 if selected<1 then selected=#people end
 if selected>#people then selected=1 end
end

function update_controls()
 if stat(30) then
  handle_number_key(stat(31))
 end
 if btnp(0) then cycle_selection(-1) end
 if btnp(1) then cycle_selection(1) end
 if btnp(4) then transfer_to(selected) end
 return btnp(5)
end

function update_nodes()
 local wearer=people[crown]
 wearer.vx=0
 wearer.vy=0

 for i=1,#people do
  local p=people[i]
  if i~=crown and not p.seated then
   pull_toward(p,wearer,0.0175,0.45)
  end
  if touches_hazard_wall(p) then
   return true
  end
 end

 for i=1,#hazards do
  local h=hazards[i]
  pull_toward(h,wearer,0.0125,0.35)
  if touching(wearer,h) then
   return true
  end
 end
end

function update_play()
 if update_controls() then
  load_level(level_index)
  return
 end

 total_frames=total_frames+1
 level_frames=level_frames-1
 if level_frames<=0 then
  load_level(level_index)
  return
 end

 if update_nodes() then
  load_level(level_index)
  return
 end
 if transfer_flash>0 then
  transfer_flash=transfer_flash-1
 end

 if all_seated() then
  if run_mode=="select" then
   clear_level=level_index
   clear_frames=total_frames
   mode="clear"
  elseif level_index<level_count then
   load_level(level_index+1)
  else
   final_frames=total_frames
   mode="win"
  end
 end
end

function _update60()
 if mode=="title" then
  if btnp(2) then
   menu_choice=menu_choice-1
   if menu_choice<1 then menu_choice=3 end
  end
  if btnp(3) then
   menu_choice=menu_choice+1
   if menu_choice>3 then menu_choice=1 end
  end
  if btnp(4) then
   if menu_choice==1 then
    start_game()
   elseif menu_choice==2 then
    mode="select"
   else
    mode="instructions"
   end
  end
 elseif mode=="select" then
  if btnp(0) then change_selected_level(-1) end
  if btnp(1) then change_selected_level(1) end
  if btnp(2) then change_selected_level(-5) end
  if btnp(3) then change_selected_level(5) end
  if btnp(4) then start_selected_level() end
  if btnp(5) then mode="title" end
 elseif mode=="play" then
  update_play()
 elseif mode=="clear" then
  if btnp(4) then mode="select" end
  if btnp(5) then mode="title" end
 elseif mode=="instructions" then
  if btnp(4) or btnp(5) then mode="title" end
 elseif mode=="win" then
  if btnp(4) or btnp(5) then
   mode="title"
  end
 end
end

function draw_node(p,i)
 local col=12
 if p.seated then col=11 end
 if i==crown then col=9 end
 if i==selected then
  spr(11,p.x-4,p.y-4)
 end
 pal(12,col)
 spr(i+1,p.x-4,p.y-4)
 pal()
 if i==crown then spr(10,p.x-4,p.y-12) end
end

function draw_hazard(h)
 spr(hazard_tile,h.x-4,h.y-4)
end

function draw_seat(s,i,filled)
 local col=6
 if filled then col=3 end
 pal(6,col)
 spr(i+4,s.x-4,s.y-4)
 pal()
end

function draw_play()
 cls(1)
 rect(3,13,124,118,5)

 local wearer=people[crown]
 for i=1,#people do
  if i~=crown and not people[i].seated then
   line(wearer.x,wearer.y,
    people[i].x,people[i].y,13)
  end
 end
 for i=1,#hazards do
  line(wearer.x,wearer.y,
   hazards[i].x,hazards[i].y,8)
 end

 for i=1,#walls do
  local w=walls[i]
  spr(wall_tile,w[1],w[2])
 end
 for i=1,#hazard_walls do
  local w=hazard_walls[i]
  spr(hazard_wall_tile,w[1],w[2])
 end

 for i=1,#seats do
  draw_seat(seats[i],i,people[i].seated)
 end
 for i=1,#hazards do
  draw_hazard(hazards[i])
 end
 for i=1,#people do
  draw_node(people[i],i)
 end

 print(level_index.."/"..level_count,5,4,7)
 local seconds=flr((level_frames+59)/60)
 local timer_col=7
 if seconds<=5 then timer_col=8 end
 print("time "..seconds,46,4,timer_col)
 print("left "..remaining_nodes(),83,4,7)
 print("lr pick z crown x reset",16,121,6)

 if transfer_flash>0 then
  rect(1,11,126,120,10)
 end
end

function draw_title()
 cls(1)
 print("heavy is the crown",27,10,10)
 spr(10,60,21)
 spr(12,60,29)
 local c1=6
 local c2=6
 local c3=6
 if menu_choice==1 then c1=11 end
 if menu_choice==2 then c2=11 end
 if menu_choice==3 then c3=11 end
 print("full run",48,53,c1)
 print("level select",40,67,c2)
 print("instructions",40,81,c3)
 print(">",31,39+menu_choice*14,7)
 print("up/down choose  z confirm",14,106,6)
end

function draw_instructions()
 cls(1)
 print("how to play",42,3,10)
 print("crown = center of gravity",14,14,7)
 print("crowned node stays still",16,21,6)
 print("other blue nodes fall to it",10,28,6)
 print("left/right: choose a node",14,38,7)
 print("z: transfer to chosen node",12,45,7)
 print("or press number keys 1-3",14,52,7)
 print("stop node on matching seat",12,62,11)
 print("seated nodes stay fixed",18,69,6)
 print("but can still wear crown",18,76,6)
 print("fill all seats to clear",18,83,11)
 print("red touching crown: reset",14,93,8)
 print("red wall + blue: reset",18,100,8)
 print("gray wall blocks movement",16,107,5)
 print("30 sec each level  x reset",12,114,7)
 print("x back",100,122,6)
end

function draw_select()
 cls(1)
 print("select a level",36,17,10)
 for n=1,level_count do
  local x=17+((n-1)%5)*23
  local y=45+flr((n-1)/5)*22
  if n==select_level then
   rect(x-5,y-5,x+10,y+9,7)
  end
  print(n,x,y,n==select_level and 11 or 6)
 end
 print("arrows move  z play",27,96,7)
 print("x back",50,110,6)
end

function draw_clear()
 cls(1)
 print("level "..clear_level.." clear",35,43,10)
 print("time: "..format_time(clear_frames),38,61,11)
 print("z level select",37,84,7)
 print("x main menu",42,98,6)
end

function draw_win()
 cls(1)
 print("the court is complete",22,48,10)
 print("the crown is still heavy",18,61,7)
 print("your time: "..format_time(final_frames),28,76,11)
 print("press z",50,96,6)
end

function _draw()
 if mode=="title" then
  draw_title()
 elseif mode=="instructions" then
  draw_instructions()
 elseif mode=="select" then
  draw_select()
 elseif mode=="play" then
  draw_play()
 elseif mode=="clear" then
  draw_clear()
 elseif mode=="win" then
  draw_win()
 end
end
