pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- ⬅️➡️⬆️⬇️❎🅾️
function _init()
	thrust=0.15
	up_thrust=0.15

	gravity_table = {
		{x=0, xmax=0, y=0.075, ymin=-0.5, ymax=3},
		{x=0.01, xmax=1, y=0.075, ymin=-0.5, ymax=3},
		{x=0, xmax=0, y=0.01, ymin=-1.5, ymax=2.5},
		{x=-0.025, xmax=-1, y=0.01, ymin=-1.5, ymax=2.5},
		{x=0, xmax=0, y=0.125, ymin=-0.5, ymax=3}
	}

	title_screen()
end

function title_screen()
	camera(0, 0)
	hold_timer = 0
	_update = function()
		pressed = {
			⬅️ = btn(⬅️),
			➡️ = btn(➡️),
			⬆️ = btn(⬆️),
			❎ = btn(❎),
			🅾️ = btn(🅾️)
		}

		if btn(🅾️) then
			hold_timer += 1
			if hold_timer == 30 then
				level = 0
				next_level()
			end
		else
			hold_timer = 0
		end
	end
	_draw = draw_title
end

function draw_title()
	cls()

	colors = {
		⬅️ = "\f6⬅️\fd",
		➡️ = "\f6➡️\fd",
		⬆️ = "\f6⬆️\fd",
		❎ = "\f6❎\fd",
		🅾️ = "\f6🅾️\fd"
	}
	for glyph, p in pairs(pressed) do
		if p then colors[glyph] = "\f3"..glyph.."\fd" end
	end
	
	local y = 18

	y = print_c("\^w\^tlunar drift", y)

	y+=10

	y = print_c("you're mission is simple:", y)
	y = print_c("safely land our surface module", y)
	y = print_c("but be careful!", y)
	y = print_c("the instruments on board are", y)
	y = print_c("very delicate.make sure to have", y)
	y = print_c("a soft landing at the bottom and", y) 
	y = print_c("avoid the asteroids!", y)

	y+=5

	y = print_c(colors.⬅️ .. " and " .. colors.➡️, y)
	y = print_c("activate horizontal thrusters", y)
	y = print_c(colors.⬆️ .. " or " .. colors.❎, y)
	y = print_c("activate upwards thruster", y)

	y+=5

	y = print_c("press and hold ".. colors.🅾️ .." to play", y)
end


function print_c(str, y)
	local text_width = print(str, 0, -20)
	local x = (128 - text_width) / 2

	x_out,y_out = print(str,x,y)
	return y_out
end

function update_game()
	if game_over then
		frame_timer += 0.2
		if frame_timer >= 1 then 
			sprite += 2 
			frame_timer = 0
		end
		if sprite == 48 then lose_menu() end
	else
		elapsed_frames += 1

		player.dx += gravity.x
		if btn(0) then
			player.dx = max(-1.5,player.dx-thrust)
		elseif btn(1) then
			player.dx = min(1.5,player.dx+thrust)
		else
			if gravity.x == 0 then player.dx*=0.95
			elseif gravity.x < 0 then 
				player.dx = max(player.dx, min(gravity.xmax, player.dx*0.95))
			else
				player.dx = min(player.dx, max(gravity.xmax, player.dx*0.95))
			end
		end

		if  btn(❎) or btn(⬆️) then
			player.dy-=up_thrust
		end

		player.dy = mid(gravity.ymin,player.dy+gravity.y,gravity.ymax)
		player.x = mid(0,player.x+player.dx,112)
		if (player.x == 0 or player.x == 112) then player.dx = 0 end
		player.y = mid(0,player.y+player.dy,490)
		if player.y == 490 then
			if player.dy >= 2 then lose()
			else win_menu() end
		end

		if btn(0) or btn(1) or btn(❎) or btn(⬆️) then
			if stat(46) == -1 then sfx(0,0) end
		else
			sfx(-1,0)
		end

		if collide(1) then lose() end
	end

	camera(0, min(player.y-56, 384))
end

function lose_menu()
	sfx(4, 1)
	_update = function()
		if btn(🅾️) then
			reset_level()
		end
	end
	_draw = function() end
	print("you lose",48,min(player.y-56, 384) + 58,7)
	print("press 🅾️ to replay",28,min(player.y-56, 384) + 66,7)
end

function win_menu()
	sfx(-1, 0)
	draw_game()
	if level == #gravity_table then
		win_game()
		return
	end

	sfx(3, 1)
	
	_update = function()
		if btn(🅾️) then
			next_level()
		end
	end

	_draw = function() end
	print("you win!",48,min(player.y-56, 384) + 58,7)
	print("press 🅾️ to continue",24,min(player.y-56, 384) + 66,7)
end

function win_game()
	sfx(2, 1)

	_update = function()
		if btn(🅾️) then
			title_screen()
		end
	end
	_draw = function() end
	print("you win!",48,min(player.y-56, 384) + 58,7)
	print("press 🅾️ to start over",20,min(player.y-56, 384) + 66,7)
end

function reset_level()
	sfx(-1)
	_update = update_game
	_draw = draw_game
	game_over = false
	sprite = 0
	frame_timer=0
	elapsed_frames=0
	player={x=56,y=56,w=16,h=14,dx=0,dy=0}
end

function lose()
	sfx(1,0)
	game_over = true
	sprite = 32
end

function next_level()
	level += 1
	gravity = gravity_table[level]
	reset_level()
end

function draw_game()
	cls()
	map()
	spr(sprite,player.x,player.y,2,2)

	local seconds = flr(elapsed_frames / 30)
	if seconds < 10 then seconds = "0"..tostr(seconds) end
	local centisecs = flr((elapsed_frames % 30) * (100 / 30))
	if centisecs < 10 then centisecs *= 10 end
	print("\^w\^t"..seconds.."."..centisecs,2,min(player.y-56, 384)+2,7)

	-- print(gravity.x,player.x-40,player.y-10)
	-- print(gravity.y)
end

function collide(flag)
    local x1 = player.x + 1
	local x2 = player.x + player.w - 3
	local x3 = (x1+x2)/2
	local y1 = player.y + 1
	local y2 = player.y + player.h - 2

	x1/=8
	x2/=8
	x3/=8
	y1/=8
	y2/=8

	if fget(mget(x1,y1), flag) then return true end
	if fget(mget(x1,y2), flag) then return true end
	if fget(mget(x2,y1), flag) then return true end
	if fget(mget(x2,y2), flag) then return true end
	if fget(mget(x3,y1), flag) then return true end
	if fget(mget(x3,y2), flag) then return true end

	return false
end

