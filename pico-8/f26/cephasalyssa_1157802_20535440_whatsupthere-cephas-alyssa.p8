pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- what's up ahead? 
-- pico-8 game jam
-- made by alyssa cephas

function _init()
    -- set up the game state
    
    -- invert timer
    invert_timer = (5 * 30)
    
    -- camera setup
    camera_x = 0
    camera_y = 128
    
    -- player pos
    player_x = 25
    player_y = 128
    
    player_speed = 1
    
    -- vert movement
    player_vy = 0
    gravity = 0.2
    
    -- jumping
    jump_strength = -3
    grounded = true
    
    flying = false
    
    -- score
				score = 0
				game_won = false
				
				-- coins
				coins = {}
				coin_timer = flr(rnd(31)) + 60
    
    -- cloudsss
    clouds = {
    {x=20, y=20, speed=1.1},
    {x=60, y=40, speed=0.9},
    {x=100, y=0, speed=1.3}
				}
				
				-- enemies
				enemies = {}
				enemy_timer = flr(rnd(61)) + 60
				game_over = false
    
    -- player animation
				anim_frame = 1
				anim_timer = 0
				facing = "right"
				end

function _update()
    -- game logic goes here
    
    -- end if game won/lost
    if game_won or game_over then				    
				    return
				end
    
    -- walking
    if btn(0) then
       player_x -= player_speed
       facing = "left"
    end
    
    if btn(1) then
    			player_x += player_speed
    			facing = "right"
   	end
   	
				-- player animation
				if flying then
				
				    -- flying animation
				    anim_timer += 1
				
				    if anim_timer >= 5 then
				        anim_timer = 0
				        anim_frame += 1
				
				        if anim_frame > 4 then
				            anim_frame = 1
				        end
				    end
				
				else
				
				    -- walking animation
				    if btn(0) or btn(1) then
				        anim_timer += 1
				
				        if anim_timer >= 5 then
				            anim_timer = 0
				
				            if anim_frame == 1 then
				                anim_frame = 2
				            else
				                anim_frame = 1
				            end
				        end
				    else
				        anim_frame = 1
				        anim_timer = 0
				    end
				
				end
   	
   	-- jumping
   	if btnp(2) and grounded then
   	   player_vy = jump_strength
   	   grounded = false
   	end
   	
   	-- gravity
   	player_vy += gravity
   	player_y += player_vy
   	
   	-- stop player at y = 80 while flying
				if flying and player_y <= 80 then
    			player_y = 80
    			player_vy = 0
				end
				
				-- camera follow player up
				if flying and player_y > 80 then
    			camera_y += player_vy
				end
   	
   	-- collisions
   	check_ground_collision()
   	
   	-- invert gravity
   	if invert_timer > 0 then
   	  	invert_timer -= 1
    else // invert here
   	   gravity = -0.2
   	   flying = true
   	end

				-- move clouds
				if flying then
				    for cloud in all(clouds) do
				        cloud.y += cloud.speed
				
				        if cloud.y > 128 then
				            cloud.y = -24
				            cloud.x = rnd(128)
				        end
				    end
				end
				
				-- coin spawning
				if flying then
				    coin_timer -= 1
				
				    if coin_timer <= 0 then
				        add(coins, {
				            x = flr(rnd(120)),
				            y = flr(rnd(5)) + 20,
				            speed = 1
				        })
				
				        coin_timer = flr(rnd(31)) + 60
				    end
				end
				
				-- coin movement
				for coin in all(coins) do
				    coin.y += coin.speed
				
				    if coin.y > 128 then
				        del(coins, coin)
				    end
				end
				
				-- coin collision
				-- calc player's screen y-coords for collisions
				local player_screen_y = player_y - camera_y
				
				for coin in all(coins) do
				    if player_x + 2 < coin.x + 6
				    and player_x + 6 > coin.x + 2
				    and player_screen_y + 2 < coin.y + 6
				    and player_screen_y + 6 > coin.y + 2 then
				
				        del(coins, coin)
				        sfx(0)
				        score += 1
				
				        if score >= 20 then
				            sfx(2)
				            game_won = true
				        end
				    end
				end
   	
   	-- enemy spawning
				if flying then
				    enemy_timer -= 1
				
				    if enemy_timer <= 0 then
				        add(enemies, {
				            x = flr(rnd(96)),
				            y = -32,
				            -- choose random enemy sprite
				            type = flr(rnd(5)) + 1,
				            speed = 1
				        })
				
				        enemy_timer = flr(rnd(21)) + 60
				    end
				end
				
				-- move enemies
				if flying then
				    for enemy in all(enemies) do
				        enemy.y += enemy.speed
				
				        if enemy.y > 128 then
				            del(enemies, enemy)
				        end
				    end
				end
				
				-- enemy collision
				for enemy in all(enemies) do
				
				    local enemy_size = 8
				
				    -- for big car enemies
				    if enemy.type == 2 or enemy.type == 3 then
				        enemy_size = 16
				    end
				
				    if player_x + 3 > enemy.x
				    and player_x + 5 < enemy.x + enemy_size
				    and player_screen_y + 3 > enemy.y
				    and player_screen_y + 5 < enemy.y + enemy_size then
				        sfx(1)
				        game_over = true
				    end
				end
				
end

function _draw()
				cls(12)

    camera(camera_x, camera_y)

    map(0, 0, 0, 0, 64, 64)

				-- draw player
				if flying then
				
				    if facing == "right" then
				        spr(32 + anim_frame, player_x, player_y)
				    else
				        spr(16 + anim_frame, player_x, player_y)
				    end
				
				else
				
				    if facing == "right" then
				        if btn(0) or btn(1) then
				            if anim_frame == 1 then
				                spr(2, player_x, player_y)
				            else
				                spr(3, player_x, player_y)
				            end
				        else
				            spr(1, player_x, player_y)
				        end
				
				    else
				        if btn(0) or btn(1) then
				            if anim_frame == 1 then
				                spr(5, player_x, player_y)
				            else
				                spr(6, player_x, player_y)
				            end
				        else
				            spr(4, player_x, player_y)
				        end
				    end
				
				end

    camera()
    
    -- draw clouds
				for cloud in all(clouds) do
    			draw_cloud(cloud.x, cloud.y)
				end
				
				-- draw coins
				for coin in all(coins) do
				    spr(49, coin.x, coin.y)
				end
				
				-- draw enemies
				for enemy in all(enemies) do
				    draw_enemy(enemy)
				end
				
			 -- display score
			 color(0)
    print("coins: "..score, 5, 5)
				
				-- win screen
				if game_won then
								color(10)
				    print("you win!", 48, 50)
				end
				
				-- lose screen
				if game_over then
				    color(8)
				    print("game over!", 45, 50)
				end
				
end

-- helper functions
function check_ground_collision()
    local left = flr(player_x / 8)
    local right = flr((player_x + 7) / 8)
    local bottom = flr((player_y + 8) / 8)

    if fget(mget(left, bottom), 0)
    or fget(mget(right, bottom), 0) then

        player_y = bottom * 8 - 8
        player_vy = 0
        grounded = true
        return true
    end

    grounded = false
    return false
end

function draw_cloud(x, y)
    for row = 0, 2 do
        for col = 0, 3 do
            spr(68 + col + row * 16, x + col * 8, y + row * 8)
        end
    end
end

function draw_enemy(enemy)
    if enemy.type == 1 then -- trashcan enemy
        spr(8, enemy.x, enemy.y)

    elseif enemy.type == 2 then -- green car enemy
        spr(10, enemy.x, enemy.y)
        spr(11, enemy.x + 8, enemy.y)
        spr(26, enemy.x, enemy.y + 8)
        spr(27, enemy.x + 8, enemy.y + 8)

    elseif enemy.type == 3 then -- pink car enemy
        spr(13, enemy.x, enemy.y)
        spr(14, enemy.x + 8, enemy.y)
        spr(29, enemy.x, enemy.y + 8)
        spr(30, enemy.x + 8, enemy.y + 8)

    elseif enemy.type == 4 then -- flying person 1
        spr(44, enemy.x, enemy.y)

    elseif enemy.type == 5 then -- flying person 2
        spr(40, enemy.x, enemy.y)
    end
end

-- win/lose conditions
-- win if 20 coins collected
			-- trigger end sequence
			
-- lose on-hit with enemies
				-- overlay game over screen +
				-- 'x' to restart
