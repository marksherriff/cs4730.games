pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	--player table
	player = {
		x = 63,
		y = 112,
		w = 8,
		h = 8,
		flipped = false,
		sp = 1,
		dx = 0,
		dy = 0,
		max_dx = 2,
		max_dy = 3,
		acc = 0.5,
		grounded = false
	}
	game_over = false
	you_win = false
	cam_x = 0
	cam_y = 0
	init_monster()
end

function _update()
	if not game_over and not you_win then
		move_player()
		jump_player()
		update_camera()
		update_monster()
		check_hazards()
		check_goal()
	else
		if btnp(4) then _init() end
	end
end

function _draw()
	camera(cam_x, cam_y)
	cls()
	map()
	draw_monster() 
	spr(player.sp, player.x, player.y, 1, 1, player.flipped)
	camera()

	if game_over then
		rectfill(24,54,104,74,0)
		print("you died!",44,58,8)
		print("(z) to retry",36,66,7)
	end
	if you_win then
		rectfill(24,54,104,74,0)
		print("you win!",44,58,11)
		print("(z) to play again",26,66,7)
	end
end
-->8
function tile_flag_at(x, y, flag)
	local cx, cy = flr(x / 8), flr(y / 8)
	return fget(mget(cx, cy), flag)
end

function move_player()
	if btn(0) then
		player.dx -= player.acc
		player.flipped = true
	elseif btn(1) then
		player.dx += player.acc
		player.flipped = false
	else
		player.dx *= 0.8
	end
	player.dx = mid(-player.max_dx, player.dx, player.max_dx)

	player.x += player.dx

	if player.dx > 0 then
		if tile_flag_at(player.x+player.w, player.y, 0)
		or tile_flag_at(player.x+player.w, player.y+player.h-1, 0) then
			player.x = flr((player.x+player.w)/8)*8 - player.w
			player.dx = 0
		end
	elseif player.dx < 0 then
		if tile_flag_at(player.x, player.y, 0)
		or tile_flag_at(player.x, player.y+player.h-1, 0) then
			player.x = flr(player.x/8)*8 + 8
			player.dx = 0
		end
	end
end

function jump_player()
	player.dy = min(player.dy + 0.2, player.max_dy)

	if btnp(4) and player.grounded then
		player.dy = -player.max_dy
		player.grounded = false
	end

	player.y += player.dy
	player.grounded = false

	if player.dy >= 0 then
		local lx, rx = player.x, player.x+player.w-1
		local by = player.y+player.h
		if tile_flag_at(lx, by, 0) or tile_flag_at(rx, by, 0)
		or tile_flag_at(lx, by, 1) or tile_flag_at(rx, by, 1) then
			player.y = flr(by/8)*8 - player.h
			player.dy = 0
			player.grounded = true
		end
	else
		if tile_flag_at(player.x, player.y, 0)
		or tile_flag_at(player.x+player.w-1, player.y, 0) then
			player.y = flr(player.y/8)*8 + 8
			player.dy = 0
		end
	end
end

function check_hazards()
	local corners = {
		{player.x, player.y},
		{player.x+player.w-1, player.y},
		{player.x, player.y+player.h-1},
		{player.x+player.w-1, player.y+player.h-1}
	}
	for c in all(corners) do
		if tile_flag_at(c[1], c[2], 2) then
			game_over = true
		end
	end
end

function update_camera()
	local map_w = 128 * 8 
	local map_h = 16 * 8  

	cam_x = player.x + player.w/2 - 64
	cam_y = player.y + player.h/2 - 64

	cam_x = mid(0, cam_x, map_w - 128)
	cam_y = mid(0, cam_y, map_h - 128)
end

function check_goal()
	local corners = {
		{player.x, player.y},
		{player.x+player.w-1, player.y},
		{player.x, player.y+player.h-1},
		{player.x+player.w-1, player.y+player.h-1}
	}
	for c in all(corners) do
		if tile_flag_at(c[1], c[2], 3) then
			you_win = true
		end
	end
end
-->8
function init_monster()
	monster = {
		x = 0, y = 88, -- starting position, adjust as needed
		w = 16, h = 16,
		sp = 2,
		pull_r = 70,
		pull_force = 0.35,
		kill_r = 8,
		chase_speed = 0.6
	}
end

function update_monster()
	-- determine if monster is currently visible on screen
	local screen_x = monster.x - cam_x
	local screen_y = monster.y - cam_y
	local offscreen = screen_x < -monster.w or screen_x > 128
	               or screen_y < -monster.h or screen_y > 128

	local speed = offscreen and monster.chase_speed * 3 or monster.chase_speed

	-- chase the player
	local dx = (player.x - player.w) - monster.x
	local dy = player.y - monster.y
	local dist = sqrt(dx*dx + dy*dy)

	if dist > 0.01 then
		monster.x += (dx/dist) * speed
		monster.y += (dy/dist) * speed
	end

	-- pull the player toward the monster
	local cx, cy = player.x + player.w/2, player.y + player.h/2
	local mx, my = monster.x + monster.w/2, monster.y + monster.h/2
	local pdx, pdy = mx - cx, my - cy
	local pdist = sqrt(pdx*pdx + pdy*pdy)

	if pdist < monster.pull_r and pdist > 0.01 then
		local strength = monster.pull_force * (1 - pdist/monster.pull_r)
		player.dx += (pdx/pdist) * strength
		player.dy += (pdy/pdist) * strength
	end

	if pdist < monster.kill_r then
		game_over = true
	end
end

function draw_monster()
	spr(monster.sp, monster.x, monster.y, 2, 2) 
end
