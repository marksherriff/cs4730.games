-- sattelite racer v 0.1


-- outdated variables
-- to be removed when gravity
-- is added
score = 0
radius = 30
originx = 64
originy = 64
angle = 0
angle_r = 0
-- size > 12 too big
-- size < 12 poor detail
size = 12 
x = 0
y = 0
sa = 0
s = 1
start = 0
alive = true
scroll_speed = 0.75


function _init()
	cls()
	local start_x = 20
	local start_y = 50
	add_planet()
	print ("\f9★ \fcsatellite racer \f9★", start_x, start_y)
	print ("press ❎ to start", start_x+9,start_y+10, 7)
	print ("\fc arrow keys to rotate", start_x - 1, start_y+20)
	print ("🅾️ to launch satellite")
	while (start == 0) do
		if btn(❎) then start = 1 end
	end

	
end

function _update()
		cls()
		current_planet(satellite)
		if not (check_collision(satellite))then
			if (satellite.angle < 0) then
				satellite.angle += 1
			end
			satellite.angle = angle_r / 360
			if btn(➡️) then angle_r -= 5 end
			if btn(⬅️) then angle_r +=5 	end
			if btn(🅾️) then sat_fart(satellite) end
			update_pos(satellite)
		else 
			s = 3
		end
		update_map()
end


function _draw()

	--rect(0,0,127,127, 8)
	draw_map()
end



-- borrowed from greygraphics
-- on pico8 forums
function rspr(sx,sy,sw,sh,a,dx,dy,dw,dh)
    local sx,sy,sw,sh,a,dx,dy,dw,dh=
        sx or 0, sy or 0,
        sw or 8, sh or 8,
        a or 0,
        dx or 0, dy or 0,
        dw or 8, dh or 8
   
    local s1,c1 = sin(a+0+0.125),cos(a+0+0.125)
    local half_dw,half_dh = dw/2,dh/2
    local x1,y1 = half_dw*c1,half_dh*s1
    local x2,y2 = half_dw*s1,half_dh*-c1
    local x3,y3 = half_dw*-c1,half_dh*-s1
    local x4,y4 = half_dw*-s1,half_dh*c1
   
    for y=0,dh-1 do
        local ty = y/dh
        local stx,sty = x2+(x3-x2)*ty,y2+(y3-y2)*ty
        local enx,eny = x1+(x4-x1)*ty,y1+(y4-y1)*ty
        for x=0,dw-1 do
            local tx = x/dw
            local px,py = stx+(enx-stx)*tx,sty+(eny-sty)*tx
            local col = sget(sx+sw*tx,sy+sh*ty)
            if (col ~= 0)    pset(dx+px,dy+py,col)
        end
    end
end
