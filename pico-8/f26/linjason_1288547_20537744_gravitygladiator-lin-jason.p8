pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()

title_screen=true
music(0, 0, 27)
 gravity=1
 gravity_timer=180

 ceiling=10
 floor_y=112

 game_over=false

 p={
  x=64,
  y=100,
  dx=0,
  dy=0,
  hp=5,
  facing=1
 }

 attack_timer=0

 enemies={}
 wave=1

 spawn_wave()

end

function spawn_wave()

 for i=1,wave+2 do

  add(enemies,{
   x=rnd(120),
   y=112,
   dy=0,
   hp=3
  })

 end

end

function _update()
 -- title screen

 if title_screen then

  if btnp(5) then
   title_screen=false
  end

  return

 end

 -- game over

 if game_over then

  if btnp(5) then
   _init()
  end

  return

 end

 -- broken gravity

 gravity_timer-=1

 if gravity_timer<=0 then

  gravity+=flr(rnd(5))-2

  gravity=mid(0,gravity,8)

  gravity_timer=180

 end

 -- movement

 if btn(0) then

  p.dx=-1
  p.facing=-1

 elseif btn(1) then

  p.dx=1
  p.facing=1

 else

  p.dx=0

 end

 p.x+=p.dx
 p.x=mid(0,p.x,127)

 -- jump

 if btnp(4) and p.y>=floor_y then
  p.dy=-4
 end

 -- gravity

 p.dy+=0.1*gravity
 p.y+=p.dy

 -- ceiling

 if p.y<ceiling then

  p.y=ceiling

  if p.dy<0 then
   p.dy=0
  end

 end

 -- landing

 if p.y>floor_y then

  if p.dy>5 then

   local slam_dmg=2

   if gravity>=6 then
    slam_dmg=4
   end

   for e in all(enemies) do

    if abs(e.x-p.x)<25 then
     e.hp-=slam_dmg
    end

   end

  end

  p.y=floor_y
  p.dy=0

 end

 -- sword attack

 if btnp(5) then

  attack_timer=6

  for e in all(enemies) do

   local attack_x=p.x+p.facing*16

   if abs(e.x-attack_x)<12 and
      abs(e.y-p.y)<12 then

      e.hp-=1

   end

  end

 end

 if attack_timer>0 then
  attack_timer-=1
 end

 -- enemies

 for e in all(enemies) do

  if e.x<p.x then
   e.x+=0.4
  else
   e.x-=0.4
  end

  -- gravity affects enemies

  e.dy+=0.1*gravity
  e.y+=e.dy

  if e.y>floor_y then
   e.y=floor_y
   e.dy=0
  end

  if e.y<ceiling then
   e.y=ceiling
   e.dy=0
  end

  -- damage player

  if abs(e.x-p.x)<5 and
     abs(e.y-p.y)<10 then

     p.hp-=0.01

  end

  if e.hp<=0 then
   del(enemies,e)
  end

 end

 -- next wave

 if #enemies==0 then

  wave+=1

  spawn_wave()

 end

 -- game over trigger

 if p.hp<=0 then

  p.hp=0

  game_over=true

 end

end

function _draw()

 cls(1)
 -- title screen

 if title_screen then

  rectfill(0,0,127,127,1)

  print("gravity gladiator",28,36,7)
  print("survive the",38,52,6)
  print("broken gravity",34,60,6)

  if flr(time()*2)%2==0 then
   print("press x to start",26,88,10)
  end

  return

 end
 -- ceiling

 line(0,ceiling,127,ceiling,5)

 -- floor

 rectfill(0,120,127,127,3)

 -- player sprite (sprite 1)

spr(
 1,
 p.x-4,
 p.y-8,
 1,
 1,
 p.facing==-1
)

 -- sword

 if attack_timer>0 then

  line(
   p.x,
   p.y-4,
   p.x+p.facing*14,
   p.y-4,
   10
  )

 end

 -- enemy sprite (sprite 2)

for e in all(enemies) do
 spr(2, e.x-4, e.y-8)
end


 print("hp:"..flr(p.hp),2,2,7)
 print("wave:"..wave,2,10,7)
 print("g:"..gravity,2,18,10)
 print("next g:"..flr(gravity_timer/30),2,26,7)

 -- controls

 print("left/right move",2,88,6)
 print("z jump",2,96,6)
 print("x sword",2,104,6)

 if gravity==0 then

  print("zero gravity!",40,2,12)

 elseif gravity>=6 then

  print("extreme gravity!",32,2,8)

 end

 -- game over screen

 if game_over then

  rectfill(18,45,110,85,0)
  rect(18,45,110,85,7)

  print("game over",40,52,8)
  print("wave:"..wave,42,62,7)

  if flr(time()*2)%2==0 then
   print("x = restart",34,74,11)
  end

 end

end
