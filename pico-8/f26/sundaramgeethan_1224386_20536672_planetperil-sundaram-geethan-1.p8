pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 world_w=512 world_mid=256 curve_amt=3

 accel=.15 friction=.08 max_speed=2
 jump_power=3 gravity=.18
 hold_gravity=.055 max_fall=3 long_hold=10

 dash_speed=5 dash_len=6

 max_monsters=4
 invuln_time=60

 life_spr={
  [0]=61,[1]=59,[2]=29,[3]=27
 }

 menu=true
 game_over=false

 -- menu music
 music(24)
end


function start_game()
 bottom_terrain={}
 top_terrain={}
 make_terrain(bottom_terrain)
 make_terrain(top_terrain)

 stars={}
 make_stars(100)

 p={
  x=64,y=0,
  dx=0,dy=0,
  facing=1,
  sprite=1,

  grounded=true,
  planet=0,
  flip_y=false,
  anim=0,

  jump_hold=0,
  can_long=false,
  transfer=nil,

  reacting=false,
  react_t=0,
  saved_dx=0,
  saved_dy=0,

  dash_t=0,
  air_dash=false,

  invuln=0
 }

 lives=3
 game_over=false
 menu=false

 survival_t=0
 danger_t=0

 cam_x=0
 cam_y=0

 asteroids={}
 creatures={}
 monsters={}

 rock_timer=90
 creature_timer=150
 monster_timer=nil
 max_creatures=6

 first_giant=true

 p.y=bottom_y(p.x+4)-8

 -- gameplay music
 music(0)
end


--================================
-- world
--================================

function make_stars(n)
 for i=1,n do
  add(stars,{
   x=rnd(world_w+128)-64,
   y=rnd(180)-55,
   fx=rnd()<.5,
   fy=rnd()<.5
  })
 end
end


function make_terrain(t)
 local h=0

 for i=1,world_w/8+2 do
  if rnd()<.35 then
   h+=flr(rnd(3))-1
  end

  h=mid(-1,h,1)
  t[i]=h
 end
end


function terrain_at(t,x)
 return t[
  mid(1,flr(x/8)+1,#t)
 ]
end


function curve_at(x)
 local d=mid(
  0,
  abs(x-world_mid)/world_mid,
  1
 )

 return curve_amt*
  (1-cos(d*.25))
end


function bottom_y(x)
 return
  104+
  curve_at(x)+
  terrain_at(
   bottom_terrain,x
  )
end


function top_tile_y(x)
 return
  -5-
  curve_at(x)+
  terrain_at(
   top_terrain,x
  )
end


function top_y(x)
 return top_tile_y(x)+8
end


function middle_y(x)
 return
  (bottom_y(x)+top_y(x))/2
end


function grav_dir()
 return
  p.planet==0
  and 1 or -1
end


--================================
-- update
--================================

function _update()

 -- menu
 if menu then
  if btnp(4) then
   start_game()
  end
  return
 end


 -- retry
 if game_over then
  if btnp(4) then
   start_game()
  end
  return
 end


 survival_t+=1
 danger_t+=1


 -- invincibility countdown
 if p.invuln>0 then
  p.invuln-=1
 end


 update_asteroids()
 if game_over then return end

 update_creatures()
 if game_over then return end

 update_monsters()
 if game_over then return end


 --================================
 -- hurt animation
 --================================

 if p.reacting then
  p.dx=0
  p.dy=0

  p.sprite=
   flr(p.react_t/3)%2==0
   and 4 or 5

  p.react_t+=1

  if p.react_t>=18 then
   p.reacting=false
   p.react_t=0

   p.dx=p.saved_dx
   p.dy=p.saved_dy
  end

  update_camera()
  return
 end


 --================================
 -- planet transfer
 --================================

 if p.transfer then
  update_transfer()
  update_camera()
  return
 end


 --================================
 -- dash
 -- btn 5
 --================================

 if btnp(5)
 and p.dash_t==0
 and (
  p.grounded
  or not p.air_dash
 ) then

  if not p.grounded then
   p.air_dash=true
  end

  p.dash_t=dash_len
  p.dy=0

  p.can_long=false
  p.jump_hold=0

  sfx(4)
 end


 if p.dash_t>0 then
  p.sprite=40

  p.x=mid(
   0,
   p.x+
   p.facing*dash_speed,
   world_w-8
  )

  p.dash_t-=1
  p.dy=0

  if p.grounded then
   snap_to_planet()
  end

  update_camera()
  return
 end


 update_horizontal()


 --================================
 -- jump
 -- btn 4
 --================================

 if btnp(4)
 and p.grounded then

  p.dy=
   -jump_power*grav_dir()

  p.grounded=false
  p.jump_hold=0
  p.can_long=true

  sfx(0)
 end


 -- long jump
 if not p.grounded
 and p.can_long then

  local g=grav_dir()

  if btn(4)
  and p.dy*g<0 then

   p.jump_hold+=1

   if p.jump_hold>=long_hold then
    p.transfer="mid"
    p.sprite=3

    update_camera()
    return
   end

  elseif not btn(4) then
   p.can_long=false
  end
 end


 --================================
 -- gravity
 --================================

 if not p.grounded then
  local g=grav_dir()

  p.dy+=
   btn(4)
   and p.can_long
   and p.dy*g<0
   and hold_gravity*g
   or gravity*g

  p.dy=
   g==1
   and min(
    p.dy,max_fall
   )
   or max(
    p.dy,-max_fall
   )
 end


 p.x=mid(
  0,
  p.x+p.dx,
  world_w-8
 )


 if p.grounded then
  snap_to_planet()
 else
  p.y+=p.dy
  check_planet_collision()
 end


 update_animation()
 update_camera()
end


--================================
-- horizontal movement
--================================

function update_horizontal()

 if btn(0) then
  p.dx-=accel
  p.facing=-1

 elseif btn(1) then
  p.dx+=accel
  p.facing=1

 elseif p.dx>0 then
  p.dx=max(
   0,
   p.dx-friction
  )

 elseif p.dx<0 then
  p.dx=min(
   0,
   p.dx+friction
  )
 end


 p.dx=mid(
  -max_speed,
  p.dx,
  max_speed
 )
end


--================================
-- difficulty
--================================

function difficulty()
 return min(
  1,
  danger_t/3600
 )
end


function next_rock_delay()
 local d=difficulty()
 local lo=75-55*d

 return lo+
  rnd(
   (125-85*d)-lo
  )
end


function next_creature_delay()
 local d=difficulty()
 local lo=120-85*d

 return lo+
  rnd(
   (210-140*d)-lo
  )
end


function next_monster_delay()
 return 150+rnd(600)
end


--================================
-- asteroids
--================================

function update_asteroids()
 rock_timer-=1


 if rock_timer<=0 then
  spawn_asteroid()

  rock_timer=
   next_rock_delay()
 end


 for i=#asteroids,1,-1 do
  local a=asteroids[i]

  a.x+=a.dx


  if a.x<-a.size-8
  or a.x>world_w+8 then

   deli(asteroids,i)


  elseif
   not p.reacting
   and p.invuln<=0
   and box_hit(
    p.x,p.y,8,8,
    a.x,a.y,
    a.size,a.size
   )
  then

   hurt_player()
   deli(asteroids,i)

   if game_over then
    return
   end
  end
 end
end


function spawn_asteroid()
 local big=rnd()<.5

 local size=
  big and 16 or 8

 local left=rnd()<.5


 local x=
  left and -size
  or world_w


 local dx=
  left
  and .8+rnd(1.2)
  or -(.8+rnd(1.2))


 local miny=
  top_y(x+size/2)+4


 local maxy=
  bottom_y(x+size/2)
  -size-4


 if maxy<miny then
  miny=
   middle_y(x+size/2)

  maxy=miny+1
 end


 add(asteroids,{
  x=x,

  y=
   miny+
   rnd(maxy-miny),

  dx=dx,
  size=size,

  fx=rnd()<.5,
  fy=rnd()<.5
 })
end


--================================
-- creatures
--================================

function update_creatures()
 creature_timer-=1


 if creature_timer<=0 then

  if #creatures
  <max_creatures then

   spawn_creature()
  end

  creature_timer=
   next_creature_delay()
 end


 for i=#creatures,1,-1 do
  local c=creatures[i]

  c.x+=c.dx
  c.anim+=1


  c.y=
   c.planet==0
   and bottom_y(c.x+4)-8
   or top_y(c.x+4)


  if c.x<-16
  or c.x>world_w+16 then

   deli(creatures,i)


  elseif
   not p.reacting
   and p.invuln<=0
   and box_hit(
    p.x,p.y,8,8,
    c.x,c.y,8,8
   )
  then

   hurt_player()
   deli(creatures,i)

   if game_over then
    return
   end
  end
 end
end


function spawn_creature()
 local kind=
  rnd()<.5
  and 1 or 2

 local planet=
  flr(rnd(2))

 local left=rnd()<.5


 local x=
  left and -8
  or world_w


 local dir=
  left and 1 or -1


 local speed=
  .25+rnd(.2)


 if kind==2 then
  speed=1.5+rnd(.8)
 end


 add(creatures,{
  x=x,

  y=
   planet==0
   and bottom_y(x+4)-8
   or top_y(x+4),

  dx=dir*speed,
  planet=planet,
  kind=kind,

  anim=
   flr(rnd(20))
 })
end


--================================
-- giant monsters
--================================

function update_monsters()

 -- unlock after 30 sec
 if danger_t<900 then
  return
 end


 if monster_timer==nil then
  monster_timer=
   90+rnd(210)
 end


 monster_timer-=1


 -- maximum 4 giants
 if monster_timer<=0
 and #monsters<max_monsters then

  spawn_monster()

  monster_timer=
   next_monster_delay()
 end


 for i=#monsters,1,-1 do
  local m=monsters[i]

  m.x+=m.dx
  m.anim+=1


  if m.hit_t>0 then
   m.hit_t-=1
  end


  m.y=
   m.planet==0
   and bottom_y(
    m.x+16
   )-32
   or top_y(
    m.x+16
   )


  -- footstep while visible
  if m.anim%14==0 then
   local sx=m.x-cam_x
   local sy=m.y-cam_y

   if sx>-32
   and sx<128
   and sy>-32
   and sy<128 then

    sfx(3)
   end
  end


  if m.x<-40
  or m.x>world_w+40 then

   deli(monsters,i)


  elseif
   not p.reacting
   and p.invuln<=0
   and m.hit_t<=0
   and box_hit(
    p.x,p.y,8,8,
    m.x,m.y,32,32
   )
  then

   hurt_player()

   if game_over then
    return
   end

   m.hit_t=45
  end
 end
end


function spawn_monster()

 -- first giant bottom,
 -- later giants random
 local planet=
  first_giant
  and 0
  or flr(rnd(2))


 first_giant=false


 local left=rnd()<.5


 local x=
  left and -32
  or world_w


 local dir=
  left and 1 or -1


 add(monsters,{
  x=x,

  y=
   planet==0
   and bottom_y(
    x+16
   )-32
   or top_y(
    x+16
   ),

  dx=
   dir*(.12+rnd(.08)),

  planet=planet,
  anim=0,
  hit_t=0
 })
end


--================================
-- collision / damage
--================================

function box_hit(
 x1,y1,w1,h1,
 x2,y2,w2,h2
)

 return
  x1<x2+w2
  and x1+w1>x2
  and y1<y2+h2
  and y1+h1>y2
end


function hurt_player()

 if game_over
 or p.invuln>0 then
  return
 end


 lives-=1
 p.dash_t=0


 --================================
 -- death
 --================================

 if lives<=0 then
  lives=0

  -- set dead sprite first
  p.sprite=24

  game_over=true

  p.dx=0
  p.dy=0

  p.reacting=false
  p.transfer=nil
  p.can_long=false
  p.invuln=0

  music(-1)

  for ch=0,3 do
   sfx(-1,ch)
  end

  return
 end


 --================================
 -- survived hit
 --================================

 sfx(1)

 -- 1 second immunity
 p.invuln=invuln_time

 p.saved_dx=p.dx
 p.saved_dy=p.dy

 p.reacting=true
 p.react_t=0
 p.sprite=4
end


--================================
-- planet transfer
--================================

function update_transfer()

 p.x=mid(
  0,
  p.x+p.dx,
  world_w-8
 )


 if p.transfer=="mid" then

  local target=
   middle_y(p.x+4)-4

  p.y+=
   (target-p.y)*.12

  p.sprite=3


  if abs(target-p.y)<.5 then
   p.y=target
   p.dy=0


   if p.planet==0 then
    p.planet=1
    p.flip_y=true
   else
    p.planet=0
    p.flip_y=false
   end


   sfx(2)

   p.transfer="fall"
  end


 else

  local g=grav_dir()

  p.dy+=gravity*g


  p.dy=
   g==1
   and min(
    p.dy,max_fall
   )
   or max(
    p.dy,-max_fall
   )


  p.y+=p.dy
  p.sprite=3

  check_transfer_landing()
 end
end


function check_transfer_landing()

 if p.planet==0 then

  local s=
   bottom_y(p.x+4)


  if p.y+8>=s
  and p.dy>=0 then

   p.y=s-8
   finish_transfer()
  end


 else

  local s=
   top_y(p.x+4)


  if p.y<=s
  and p.dy<=0 then

   p.y=s
   finish_transfer()
  end
 end
end


function finish_transfer()
 p.dy=0

 p.grounded=true
 p.transfer=nil

 p.jump_hold=0
 p.can_long=false
 p.air_dash=false

 p.sprite=1
 p.anim=0
end


--================================
-- planet collision
--================================

function snap_to_planet()

 p.y=
  p.planet==0
  and bottom_y(p.x+4)-8
  or top_y(p.x+4)
end


function check_planet_collision()

 if p.planet==0 then

  local s=
   bottom_y(p.x+4)


  if p.y+8>=s
  and p.dy>=0 then

   p.y=s-8
   landed()
  end


 else

  local s=
   top_y(p.x+4)


  if p.y<=s
  and p.dy<=0 then

   p.y=s
   landed()
  end
 end
end


function landed()
 p.dy=0

 p.grounded=true

 p.jump_hold=0
 p.can_long=false
 p.air_dash=false
end


--================================
-- animation
--================================

function update_animation()

 if p.reacting then
  return
 end


 if not p.grounded then
  p.sprite=3
  p.anim=0


 elseif abs(p.dx)>.1 then
  p.anim+=1

  p.sprite=
   flr(p.anim/6)%2==0
   and 1 or 2


 else
  p.sprite=1
  p.anim=0
 end
end


--================================
-- camera
--================================

function update_camera()

 local tx=mid(
  0,
  p.x-60,
  world_w-128
 )


 local ty=mid(
  -56,
  p.y-72,
  0
 )


 cam_x+=
  (tx-cam_x)*.15

 cam_y+=
  (ty-cam_y)*.12


 if abs(cam_x)<.05 then
  cam_x=0
 end


 if abs(cam_y)<.05 then
  cam_y=0
 end
end


--================================
-- drawing
--================================

function draw_stars()
 local px=cam_x*.35
 local py=cam_y*.35


 for s in all(stars) do
  local x=s.x-px
  local y=s.y-py


  if x>-8
  and x<128
  and y>-8
  and y<128 then

   spr(
    15,
    x,y,
    1,1,
    s.fx,s.fy
   )
  end
 end
end


function draw_bottom()
 local sx=
  flr(cam_x/8)*8-16


 for x=sx,sx+160,8 do

  local y=
   bottom_y(x+4)

  spr(7,x,y)


  for yy=y+8,180,8 do
   spr(7,x,yy)
  end
 end
end


function draw_top()
 local sx=
  flr(cam_x/8)*8-16


 for x=sx,sx+160,8 do

  local y=
   top_tile_y(x+4)

  spr(8,x,y)


  for yy=y-8,-100,-8 do
   spr(8,x,yy)
  end
 end
end


function draw_asteroids()

 for a in all(asteroids) do

  spr(
   a.size==8
   and 6 or 9,

   a.x,a.y,

   a.size/8,
   a.size/8,

   a.fx,a.fy
  )
 end
end


function draw_creatures()

 for c in all(creatures) do
  local s


  if c.kind==1 then

   s=
    flr(c.anim/8)%2==0
    and 11 or 12

  else

   s=
    flr(c.anim/3)%2==0
    and 13 or 14
  end


  spr(
   s,
   c.x,c.y,
   1,1,
   c.dx<0,
   c.planet==1
  )
 end
end


function draw_monsters()

 for m in all(monsters) do

  local s=
   flr(m.anim/14)%2==0
   and 16 or 20


  spr(
   s,
   m.x,m.y,
   4,4,
   m.dx>0,
   m.planet==1
  )
 end
end


--================================
-- ui
--================================

function draw_lives()

 spr(
  life_spr[lives],
  3,3,
  2,2
 )
end


function draw_timer()

 local sec=
  flr(survival_t/30)

 local rem=
  sec%60

 local t=
  flr(sec/60)..":"


 if rem<10 then
  t=t.."0"
 end


 t=t..rem


 print(
  t,
  126-#t*4,
  4,
  7
 )
end


function draw_game_over()

 spr(
  88,
  32,40,
  8,8
 )
end


--================================
-- draw
--================================

function _draw()
 cls()


 -- title screen
 if menu then
  camera()

  spr(
   80,
   32,8,
   8,8
  )

  spr(
   208,
   32,96,
   8,3
  )

  return
 end


 -- game
 draw_stars()

 camera(
  cam_x,
  cam_y
 )


 draw_top()
 draw_bottom()

 draw_creatures()
 draw_monsters()
 draw_asteroids()


 --================================
 -- player
 -- flashes while invincible
 --================================

 local show_player=true

 if p.invuln>0
 and flr(p.invuln/3)%2==0 then

  show_player=false
 end


 if show_player then

  spr(
   p.sprite,
   p.x,p.y,
   1,1,
   p.facing==-1,
   p.flip_y
  )
 end


 camera()


 draw_lives()
 draw_timer()


 if game_over then
  draw_game_over()
 end
end
