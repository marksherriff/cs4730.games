function load_level()
	l=levels[level]
	x=l.x
	y=l.y
	goalx=l.goalx
	goaly=l.goaly
	vx=0
	vy=0
	complete=false
	complete_timer=0
end

function _update()
	mx=stat(32)
	my=stat(33)
	if state=="start" then
		if stat(34)==1 then
			state="play"
			time = time_limit
			levels_completed=0
			last_level=0
			next_level()
		end
		return
	end
	if state=="over" then
		if stat(34)==1 then
			newhigh=false
			time=time_limit
			levels_completed=0
			last_level=0
			state="play"
			next_level()
		end
		return
	end
	time-=1
	if time<=0 then
		time=0
		if levels_completed>high_score then
			high_score=levels_completed
			newhigh=true
		end
		state="over"
		return
	end
	mx=stat(32)
	my=stat(33)
	if complete then
		complete_timer-=1
		if complete_timer<=0 then
			next_level()
		end
	
		return
	end
	
		dx=mx-x
		dy=my-y
		d=sqrt(dx*dx+dy*dy)
		if d>0 then
			gx = dx/d
			gy = dy/d
			vx+=gx*0.1
			vy+=gy*0.1
		end
	vx*=0.98
	vy*=0.98
	x+=vx
	wall_collisionx()
	y+=vy
	wall_collisiony()
	if x<4 then
		x=4
		vx=-vx*0.9
	end
	if x>124-w then
		x=124-w
		vx=-vx*0.9
	end
	if y<4 then
		y=4
		vy=-vy*0.9
	end
	if y>124-h then
		y=124-h
		vy=-vy*0.9
	end	
	dx=goalx-x
	dy=goaly-y
	if sqrt(dx*dx+dy*dy)<8 then
		complete=true
		levels_completed+=1
	end
end
	
function _draw()
	if state=="start" then
		draw_start()
	elseif state=="play" then
		draw_game()
	elseif state=="over" then
		draw_gameover()
	end
end

function draw_gameover()
	cls()
	print("\^w\^ttime's up!",25,10,8)
	print("levels completed",32,35,7)
	print(levels_completed,60,45,11)
	print("high score",42,60,7)
	if newhigh==true then
		print("\^w\^t★new best!★",10,80,10)
	end
	print(high_score,60,70,10)
	print("click to play again",24,100,6)
end

function draw_game()
	cls()
	rectfill(0,0,127,3,1)
	rectfill(0,124,127,127,1)
	rectfill(0,0,3,127,1)
	rectfill(124,0,127,127,1)
	draw_walls()
	circfill(goalx,goaly,goalr,11)
	rectfill(x,y,x+w-1,y+h-1,7)
	circfill(mx+4,my+4,3,8)
	print("⧗time:"..flr(time/30),5,0,10)
	print("★score:"..levels_completed,84,0,7)	
end

function draw_start()
	cls()
	print("\^w\^tgravity rush",15,20,7)
	print("click to start",35,70,6)
	print("get the box to the",30,90,5)
	print("goal using the mouse",27,100,5) 
	print("clear the most amount of",17,110,5)
	print("levels in one minute",25,120,5)
end


function draw_walls()
	for wall in all(l.walls) do
		rectfill(wall.x,
		wall.y,
		wall.x+wall.w-1,
		wall.y+wall.h-1,
		5)
	end
end

function collision(a,b)
	return a.x < b.x+b.w
	and a.x+a.w > b.x
	and a.y <b.y + b.h
	and a.y+a.h > b.y
end

function wall_collisionx()
	for wall in all(l.walls) do
		if collision(
		{x=x,y=y,w=w,h=h},
		wall ) then
			if vx>0 then
				x=wall.x-w
			else
				x=wall.x+wall.w
			end
			
			vx=-vx*0.9
		end
	end
end		

function wall_collisiony()
	for wall in all(l.walls) do
		if collision(
		{x=x,y=y,w=w,h=h},
		wall ) then
			if vy>0 then
				y=wall.y-h
			else
				y=wall.y+wall.h
			end
			
			vy=-vy*0.9
		end
	end
end		

function reset()
	load_level()
end

function next_level()
	local choices={}
	max_difficulty=1+flr(levels_completed/3)
		if max_difficulty>#levels then
			max_difficulty=#levels
		end
		
		for i=1,#levels do --<=max_difficulty
			if levels[i].difficulty<=max_difficulty and i!=last_level then
				add(choices,i)
			end
		end
		
		level = choices[flr(rnd(#choices))+1]
		last_level=level
		load_level()
	end
