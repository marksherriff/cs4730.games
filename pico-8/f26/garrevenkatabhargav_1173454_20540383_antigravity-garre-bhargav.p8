pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function reset_game()
 player_x=8
 player_y=112
 player_vx=1.2
 player_vy=-0.8
 ending_x=112
 ending_y=112
 ending_vx=-0.7
 ending_vy=-0.5
 won=false
 health=100
 game_over=false
 laser_cooldown=0
 goal_contact=0
 started=false
 game_start_time=0
 win_time=0
 final_score=0
end

function _init()
 reset_game()
end

function on_edge(x,y)
 return x==8 or x==112 or y==8 or y==112
end

function laser_is_active(laser_x)
 return flr(time()*3+laser_x)%4<2
end

function damage_player(amount)
 if laser_cooldown>0 then return end
 health=max(0,health-amount)
 laser_cooldown=20
 if health==0 then
  game_over=true
 end
end

function player_speed()
 return 0.7+0.7*health/100
end

function finish_win()
 won=true
 win_time=time()-game_start_time
 final_score=max(0,flr(1000-(100-health)*5-win_time*5))
end

function print_centered(text,y,color)
 print(text,64-#text*2,y,color)
end

function bounce_entity(x,y,vx,vy)
 if x<8 then x=8 vx=abs(vx) end
 if x>112 then x=112 vx=-abs(vx) end
 if y<8 then y=8 vy=abs(vy) end
 if y>112 then y=112 vy=-abs(vy) end
 return x,y,vx,vy
end

function update_player()
 if btn(0) then player_vx-=0.08 end
 if btn(1) then player_vx+=0.08 end
 if btn(2) then player_vy-=0.08 end
 if btn(3) then player_vy+=0.08 end

 local speed=player_speed()
 local magnitude=sqrt(player_vx*player_vx+player_vy*player_vy)
 if magnitude==0 then player_vx=speed player_vy=0
 else
   player_vx=player_vx/magnitude*speed
   player_vy=player_vy/magnitude*speed
 end

 player_x+=player_vx
 player_y+=player_vy
 player_x,player_y,player_vx,player_vy=bounce_entity(player_x,player_y,player_vx,player_vy)
end

function update_ending()
 ending_x+=ending_vx
 ending_y+=ending_vy
 ending_x,ending_y,ending_vx,ending_vy=bounce_entity(ending_x,ending_y,ending_vx,ending_vy)
end

function check_collisions()
 if abs(player_x-ending_x)<7 and abs(player_y-ending_y)<7 then
   goal_contact+=1
   if goal_contact>=8 then
    finish_win()
   end
 elseif (abs(player_x-48)<5 and laser_is_active(48)) or (abs(player_x-80)<5 and laser_is_active(80)) then
   goal_contact=0
   damage_player(10)
 else
  goal_contact=0
 end
end

function _update()
 if not started then
  if btnp(4) or btnp(5) then
   started=true
   game_start_time=time()
  end
  return
 end
 if laser_cooldown>0 then laser_cooldown-=1 end
 if (won or game_over) and (btnp(4) or btnp(5)) then
    reset_game()
    return
 end
 if won or game_over then return end
 update_player()
 update_ending()
 check_collisions()
end

function _draw()
 cls()
 if not started then
  rectfill(8,8,119,119,1)
  print("- antigravity -",34,14,7)
  print("red lasers damage health",16,31,8)
  print("float and bounce off walls",12,59,7)
  print("catch the moving goal",22,75,7)
  print("touch it to win",34,87,7)
  print("press x to start",32,106,11)
  return
 end
 map(0,0,0,0,16,16)
 if not won and not game_over then
  line(48,8,48,120,laser_is_active(48) and 8 or 0)
  line(80,8,80,120,laser_is_active(80) and 8 or 0)
 else
  line(48,8,48,120,5)
  line(80,8,80,120,5)
 end
 rect(10,10,61,16,7)
 rectfill(12,12,12+flr(47*health/100),14,8)
 spr(5,ending_x,ending_y)
 spr(51,player_x,player_y)
 if won then
   rectfill(14,36,114,100,1)
   print_centered("you win!",44,7)
  print_centered("score: "..final_score.."/1000",58,10)
   print_centered("time: "..flr(win_time).."s",70,7)
   print_centered("press x to play again",86,6)
 elseif game_over then
    rectfill(20,40,108,88,1)
    print("game over",46,48,8)
    -- rectfill(36,60,92,76,3)
    print("press x to",44,65,7)
   print("play again",44,78,7)
 end
end

