--game over state

function over_init()

 _update=over_update
 _draw=over_draw
 
	fading=1
	fadespeed=5
	sfx_played = false

end

function over_update()

	if (btnp(❎)) menu_init()	
	if fading == 0 then
		if game_over and not sfx_played then
			--sfx(12)
			sfx_played=true
		end
	end


end

function over_draw()	

	if fading > 0 then
		fadeout()
	end
	
	if fading == -1 then
		fading = 0 -- fade finished
	end
	
	if fading == 0 then
		--rectfill(0, 50, 128, 78, 5)
		spr(76, 48, 34, 4, 4) -- centered
		--spr(76, 80, 30, 4, 4) 
		print("game over!",45,69,0)
		print("game over!",44,68,8)
		print("press ❎ to return to title",11,77,0)
		print("press ❎ to return to title",10,76,7)
		
		--print("tip: hold 'a' to make \n     sheep stay in place!", 2,80,6)
	end

end
