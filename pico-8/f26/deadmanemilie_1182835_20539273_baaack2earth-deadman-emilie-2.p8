--menu state
function menu_init()

	_update=menu_update
	_draw=menu_draw
	
	poke(0x5f2e,1)
	
	stars = {}
	for i = 1, 50 do
		add(stars, {
			x = flr(rnd(128)),
			y = flr(rnd(128)),
			s = flr(rnd(3)) + 1
		})
	end

	planet_angle = 0
	
end

function menu_update()

	for st in all(stars) do
		st.y += st.s
		if (st.y > 128) st.y = 0
	end

	planet_angle -= 1

	if btnp(5) then
		if intro_seen then
		 sfx(9)
			game_init()
		else
		 sfx(9)
			intro_init()
		end
	end
	
end

function menu_draw()
	--clear screen
	cls(0) 
	
	for i=0, 15 do
		pal({[0]=0,1,2,139,132,133,134,7,136,137,10,138,140,141,142,15},1)
	end	

	-- stars
	for st in all(stars) do
		local col = (st.s == 3) and 7 or (st.s == 2) and 6 or 2
		pset(st.x, st.y, col)
	end

	-- rotating planet
	local pa = planet_angle/360
	rspr(88, 0, 16, 16, pa, 15+8, 15+8, 16, 16)

	-- title sprite
	spr(132, 32, 40, 7, 3)

	-- instructions
	print("press ❎ to play!",31,72,5)
	print("press ❎ to play!",30,72,7)
	
	-- controls
	print("controls:",30,94,5)
	print("🅾️: flip gravity",30,102,5)
	print("❎: pull flock \n    together ",30,108,5)

	
end

function intro_init()

	_update=intro_update
	_draw=intro_draw
	
	frames = {64, 68}
	frame_index = 1
	anim_timer = 0
	anim_speed = 5

	intro_lines = {
		"* my sheep are all \nstranded in space!",
		"* please help me \nbring them home.",
		"* i've given you \na gravity flipper \nand a flock magnet.",
		"* press 🅾️ to flip \ngravity, and hold \n❎ to pull sheep \ntogether.",
		"* bring the sheep \nto the green pens \nto send them back \nto earth.",
		"* ...",
		"* oh, and watch out \nfor meteors.",
		"* good luck!"
			}
	
	char_count = 0
	char_speed = 1
	intro_line = 1

end

function intro_update()

	local full_len = #intro_lines[intro_line]
	local prev_count = flr(char_count)

	if char_count < full_len then
		-- still typing: animate portrait + increment + play blip
		anim_timer += 1
		if anim_timer >= anim_speed then
			anim_timer = 0
			frame_index = frame_index == 1 and 2 or 1
		end

		char_count += char_speed
		if char_count > full_len then char_count = full_len end

		if flr(char_count) > prev_count then
			sfx(1)
		end
	else
		-- fully revealed
				frame_index = 1
	end

	if btnp(5) then
		if char_count < full_len then
			char_count = full_len
		else
			intro_line += 1
			char_count = 0
			if intro_line > #intro_lines then
				intro_seen = true
				game_init()
			end
		end
	end
end


function intro_draw()
	cls(0)

	for i=0, 15 do
		pal({[0]=0,1,2,139,132,133,134,7,136,137,10,138,140,141,142,15},1)
	end

	-- portrait, 4x4 tiles = 32x32px
	--spr(frames[frame_index], 4, 45, 4, 4)

	if intro_lines[intro_line] == "* good luck!" then
		spr(72, 4, 45, 4, 4)
	elseif intro_lines[intro_line] == "* ..." then
		spr(128, 4, 45, 4, 4)
	else
		spr(frames[frame_index], 4, 45, 4, 4)
	end

	-- dialogue box, shifted right to clear the larger portrait
	rect(1, 40, 124, 79, 7)

	local full_line = intro_lines[intro_line]
	local visible = sub(full_line, 1, flr(char_count))
	print(visible, 44, 48, 7)

	print("press ❎", 90, 100, 6)

end
