--other functions
-- rotate sprites

function rspr(sx,sy,sw,sh,a,dx,dy,dw,dh)
    local sx,sy,sw,sh,a,dx,dy,dw,dh=
        sx or 0, sy or 0,
        sw or 8, sh or 8,
        a or 0,
        dx or 0, dy or 0,
        dw or 8, dh or 8
   
    local s1,c1 = sin(a+0+0.125),cos(a+0+0.125)
    local half_dw,half_dh = dw/2,dh/2
    local x1,y1 = half_dw*c1,half_dh*s1
    local x2,y2 = half_dw*s1,half_dh*-c1
    local x3,y3 = half_dw*-c1,half_dh*-s1
    local x4,y4 = half_dw*-s1,half_dh*c1
   
    for y=0,dh-1 do
        local ty = y/dh
        local stx,sty = x2+(x3-x2)*ty,y2+(y3-y2)*ty
        local enx,eny = x1+(x4-x1)*ty,y1+(y4-y1)*ty
        for x=0,dw-1 do
            local tx = x/dw
            local px,py = stx+(enx-stx)*tx,sty+(eny-sty)*tx
            local col = sget(sx+sw*tx,sy+sh*ty)
            if (col ~= 0)    pset(dx+px,dy+py,col)
        end
    end
end


-- spawn sheep
function spawn_sheep()
	local edge = flr(rnd(4))  -- 0=top, 1=right, 2=bottom, 3=left
	local x, y, vx, vy

	if edge == 0 then       -- from top
		x = rnd(128)
		y = -10
		vx = rnd(1)-0.5
		vy = 0.5
	elseif edge == 1 then   -- from right
		x = 138
		y = rnd(128)
		vx = -0.5
		vy = rnd(1)-0.5
	elseif edge == 2 then   -- from bottom
		x = rnd(128)
		y = 138
		vx = rnd(1)-0.5
		vy = -0.5
	else                    -- from left
		x = -10
		y = rnd(128)
		vx = 0.5
		vy = rnd(1)-0.5
	end

	return {
		x = x, y = y,
		vx = vx, vy = vy,
		angle = 0,
		captured_time = 0,
		entered = false,
		inv_time = 90
	}
end


-- spawn meteor obstacles
function spawn_meteor()
	local x, y, vx, vy, edge
	local min_dist = 30
	local tries = 0

	repeat
		edge = flr(rnd(4))

		if edge == 0 then
			x = rnd(128); y = -10
			vx = rnd(1)-0.5; vy = rnd(0.5)+0.5
		elseif edge == 1 then
			x = 138; y = rnd(128)
			vx = -(rnd(0.5)+0.5); vy = rnd(1)-0.5
		elseif edge == 2 then
			x = rnd(128); y = 138
			vx = rnd(1)-0.5; vy = -(rnd(0.5)+0.5)
		else
			x = -10; y = rnd(128)
			vx = rnd(0.5)+0.5; vy = rnd(1)-0.5
		end

		local too_close = false
		for s in all(sheep) do
			local dx, dy = s.x - x, s.y - y
			if sqrt(dx*dx + dy*dy) < min_dist then
				too_close = true
			end
		end

		tries += 1
	until not too_close or tries > 10

	local ix, iy = mid(8, x, 120), mid(8, y, 120)

	sfx(10)

	return {
		x=x, y=y, vx=vx, vy=vy, angle=0,
		warning = true,
		warning_time = 45,
		ix = ix, iy = iy
	}
end

-- random int
function randint(min, max)
 return flr(rnd(max - min + 1)) + min
end

-- fadeout
-- function to fade screen
-- one cycle at a time
function fadeout()
local fade,c,p={[0]=0,17,18,19,20,16,22,6,24,25,9,27,28,29,29,31,0,0,16,17,16,16,5,0,2,4,0,3,1,18,2,4}
  fading+=1
  if fading%fadespeed==1 then
    for i=0,15 do
      c=peek(24336+i)
      if (c>=128) c-=112
      p=fade[c]
      if (p>=16) p+=112
      pal(i,p,1)
    end
    if fading==7*fadespeed+1 then
      cls()
						pal({[0]=0,1,2,139,132,133,134,7,136,137,10,138,140,141,142,15},1)
      fading=-1
    end
  end
end
