--game state

function game_init()

	_update=game_update
	_draw=game_draw

	poke(0x5f2e,1)
	
 stars = {}
 -- generate 50 stars with random x, y, and speed
 for i = 1, 50 do
   add(stars, {
     x = flr(rnd(128)),
     y = flr(rnd(128)),
     s = flr(rnd(3)) + 1 -- speed/layer (1 to 3)
   })
 end

	planet_angle = 0
	
	pull = false
	
	-- particles
	parts = {}

	-- broken gravity direction, affects sheep only
	grav = {x=0, y=1}

	-- sheep: float around, herd with gravity
	sheep = {}
	for i=1,1 do
		add(sheep, spawn_sheep())	
	end

 rescued = 0
 obstacles = false -- add obstacles when rescued=10

	meteors = {}
	meteor_timer = 0
	game_over = false

	-- the pen goal is a rectangle
	pen = {x=56, y=56, w=20, h=20}
	
	-- explosions
	exps = {}
	-- explosion colors
	clrs = {5,7,9,10}
	
	game_over_timer = 0
	
end

function game_update()


	if game_over then
		game_over_timer += 1

		-- keep updating explosion particles while waiting
		for p in all(exps) do
			p.x += p.spdx	
			p.y += p.spdy
			p.scale -= .1
			p.l -= .1
			p.c = flr(p.l)
			if p.l<=0 then del(exps, p) end
		end

		if game_over_timer > 50 then
			over_init()
		end
		return   -- skip the rest of game_update while waiting
	end

	-- explosions (normal frame, no game over yet)
	for p in all(exps) do
		p.x += p.spdx	
		p.y += p.spdy
		p.scale -= .1
		p.l -= .1
		p.c = flr(p.l)
		if p.l<=0 then del(exps, p) end
	end
	
	-- move each star down based on its speed
	for st in all(stars) do
		st.y += st.s
		if (st.y > 128) st.y = 0
	end

	-- rotate broken gravity 90 deg with x button
	if btnp(4) then
		local nx = -grav.y
		local ny = grav.x
		grav.x = nx
		grav.y = ny
	end
	
	if btn(5) then
		-- find center of the flock
		pull = true
		local cx, cy = 0, 0
		for s in all(sheep) do
			cx += s.x
			cy += s.y
		end
		cx /= #sheep
		cy /= #sheep
	
		for s in all(sheep) do
			local dx = cx - s.x
			local dy = cy - s.y
			local dist = sqrt(dx*dx + dy*dy)
			if dist > 1 then
				s.vx += (dx/dist) * 0.1
				s.vy += (dy/dist) * 0.1
			end
		end
		else
			pull = false
	end
	
	-- update sheep physics (broken gravity)
	local capture_threshold = 15
	local still_out = {}

	for s in all(sheep) do
	
		if s.inv_time > 0 then
			s.inv_time -= 1
		end


		if s.entered then
			s.vx += grav.x * 0.20
			s.vy += grav.y * 0.20
			s.vx *= 0.90
			s.vy *= 0.90
		end
	
		s.angle -= 2
		s.x += s.vx
		s.y += s.vy
	
		-- mark as "entered" once inside visible bounds
		if not s.entered and s.x >= 0 and s.x <= 127 and s.y >= 0 and s.y <= 127 then
			s.entered = true
		end
	
		-- only bounce off walls once they've entered
		if s.entered then
			if s.x < 0 then s.x=0 s.vx=-s.vx*0.5 end
			if s.x > 127 then s.x=127 s.vx=-s.vx*0.5 end
			if s.y < 0 then s.y=0 s.vy=-s.vy*0.5 end
			if s.y > 127 then s.y=127 s.vy=-s.vy*0.5 end
		end
		
		if s.inv_time <= 0 then
			for m in all(meteors) do
				if not m.warning then
					local dx = s.x - m.x
					local dy = s.y - m.y
					if sqrt(dx*dx + dy*dy) < 8 then
						if not game_over then
							sfx(2)
							for i=0,20 do
								add(exps, {
									x=s.x,
									y=s.y,
									spdx=1-rnd(2),
									spdy=1-rnd(2),
									scale=2+rnd(5),
									l=5
								})
							end
							game_over = true
						end
					end
				end
			end	
		end
			
			-- check pen overlap (still inside the loop, s is still valid here)
		if s.x > pen.x and s.x < pen.x+pen.w and s.y > pen.y and s.y < pen.y+pen.h then
			s.captured_time += 1
		else
			s.captured_time = 0
		end

		-- capture or keep
		if s.captured_time >= capture_threshold then
			rescued += 1
			sfx(5)
		else
			add(still_out, s)
		end
	end
	
	sheep = still_out

	-- new wave check
	if #sheep == 0 then
		pen.x = flr(rnd(100)) + 10
		pen.y = flr(rnd(100)) + 10

		for i=1,randint(1,6) do
			add(sheep, spawn_sheep())
		end
	end
	
	-- spawn meteors over time
	meteor_timer += 1
	if meteor_timer > 240 then
		meteor_timer = 0
		add(meteors, spawn_meteor())
	end
	
	-- move meteors, remove once far off-screen
		
	local still_meteors = {}
	for m in all(meteors) do
		if m.warning then
			m.warning_time -= 1
			if m.warning_time <= 0 then
				m.warning = false
			end
			add(still_meteors, m)  -- keep it, just don't move it yet
		else
			m.x += m.vx
			m.y += m.vy
			m.angle -= 1
			if m.x > -20 and m.x < 148 and m.y > -20 and m.y < 148 then
				add(still_meteors, m)
			end
		end
	end
	meteors = still_meteors
	
	planet_angle -= 1

end

function game_draw()
	cls()
	
	for i=0, 15 do
	--pal(i, i + 128, 1)
	--pal({[0]=0,1,2,3,132,133,134,7,136,137,138,139,140,141,142,143},1)
	--pal({[0]=0,1,2,139,132,133,134,7,136,137,10,138,140,141,142,143},1)
 	  pal({[0]=0,1,2,139,132,133,134,7,136,137,10,138,140,141,142,15},1)
	end	
	
	map(0,0)

 local pa = planet_angle/360
 rspr(88, 0, 16, 16, pa, 15+8, 15+8, 16, 16)

 -- draw each star 
 for st in all(stars) do
     -- speed 3 = white (7), speed 2 = light gray (6), speed 1 = dark-blue/purple (2/3)
 local col = (st.s == 3) and 7 or (st.s == 2) and 6 or 2
 pset(st.x, st.y, col)
 end

	-- draw pen
	rect(pen.x, pen.y, pen.x+pen.w, pen.y+pen.h, 11)

	-- draw sheep
	for s in all(sheep) do
		local sa = s.angle/360
		rspr(6*8, 0, 8, 8, sa, s.x+4, s.y+4, 16, 16)
	end

	-- draw meteors
	for m in all(meteors) do
		if m.warning then
			-- flash between two frames
			if m.warning_time % 10 < 6 then
				spr(40, m.ix-8, m.iy-8, 2, 2)
			else
				spr(42, m.ix-8, m.iy-8, 2, 2)
			end
		else
			sspr(72, 0, 16, 16, m.x, m.y, 13, 13)
		end
	end
	
	-- draw explosions
	for p in all(exps) do
		circfill(p.x, p.y, p.scale, clrs[mid(1, p.c, 4)])
	end
	
	-- debug: show current gravity direction
	-- print("grav: "..grav.x..","..grav.y, 2, 2, 7)

	local arrow_spr = 0
		if grav.y == 1 then arrow_spr = 20      -- down arrow
			elseif grav.y == -1 then arrow_spr = 22 -- up arrow
			elseif grav.x == 1 then arrow_spr = 16  -- right arrow
			elseif grav.x == -1 then arrow_spr = 18 -- left arrow
	end

	spr(arrow_spr, 2, 2, 2, 2)
	
	if pull then
	sspr(104, 0, 16, 16, 20, 2, 15, 15)
	end
	
	print("rescued: "..rescued, 80, 118, 7)
	print("sheep left: "..#sheep, 2, 118, 7)

	--spr(64,5,100,4,4)
	
end
