pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main --

lvl_w=16      -- tiles wide per level
lvl_h=16      -- tiles tall per level
npb=8         -- notes per movement beat
beat_p=4      -- flip window period, in notes
beat_tol=0    -- flip window allowance, in notes

levels={
 {x=0,  y=0},  -- 1
 {x=16, y=0},  -- 2
 {x=32, y=0},  -- 3  blue joins
 {x=48, y=0},  -- 4
 {x=64, y=0},  -- 5
 {x=80, y=0},  -- 6  green joins
 {x=96, y=0},  -- 7gr
 {x=112,y=0}   -- 8  orange joins
}

function _init()
 pause_t=0
 practice=false
 autopl=false
 menu_labels()
 start_game()
end

function start_game()
 deaths=0
 results=false
 load_level(1)   -- change to test a specific level
end

function onoff(b)
 if b then return "on" end
 return "off"
end

function menu_labels()
 menuitem(1,"practice: "..onoff(practice),toggle_practice)
 menuitem(2,"auto: "..onoff(autopl),toggle_auto)
 menuitem(3,"skip level",function() load_level(min(cur+1,#levels)) end)
 menuitem(4,"prev level",function() load_level(max(cur-1,1)) end)
end

function toggle_practice()
 practice=not practice
 menu_labels()
 load_level(cur)
end

-- full auto: every horse drives itself. a cheat, for testing
-- and for demoing the game hands-off
function toggle_auto()
 autopl=not autopl
 menu_labels()
 set_auto()
end

function set_auto()
 for h in all(horses) do h.auto=autopl end
end

function load_level(i)
 cur=i
 lvl=levels[i]
 make_horses(i)
 set_auto()

 -- silence everything, then start every present horse's layer
 -- on the same frame so the loops stay phase-locked
 for c=0,3 do sfx(-1,c) end
 for h in all(horses) do
  sfx(h.def.sfx,h.def.chan)
 end

 lastb=nil     -- nil means "first frame, just look, don't step"
 pause_t=0
end

function freeze(f,nxt,c)
 pause_t=f
 pause_next=nxt
 pause_col=c
end

function near_beat(nn,p,tol)
 local d=nn%p
 if d>p/2 then d=p-d end
 return d<=tol
end

function kill_horse(h)
 h.dead=true
 deaths+=1
 -- drop this horse's layer out of the mix, but never channel 0:
 -- that one is the clock
 if h.def.chan!=0 then sfx(-1,h.def.chan) end
end

function advance()
 results=false
 if cur>=#levels then
  start_game()
 else
  load_level(cur+1)
 end
end

function _update60()
 n=stat(20)      -- channel 0 = red's track = the clock

 if results then
  res_t+=1
  -- hands-off demo: don't wait for a button
  if btnp(4) or btnp(5) or (autopl and res_t>90) then advance() end
  return
 end

 if pause_t>0 then
  pause_t-=1
  if pause_t==0 then load_level(pause_next) end
  return
 end

 window=near_beat(n,beat_p,beat_tol)

 local b=flr(n/npb)
 local beat=(lastb!=nil and b!=lastb)
 lastb=b

 local alive=0     -- running, still inside the level
 local home=0      -- past the right edge

 for h in all(horses) do
  if not h.dead then
   h_update(h,beat)
   if h.x>=lvl_w then
    home+=1
   elseif h_hit(h) then
    kill_horse(h)
    if not practice then
     freeze(24,cur,8)
     return
    end
   else
    alive+=1
   end
  end
 end

 if practice then
  -- any horse home, or nobody left running: run the level again
  if home>0 or alive==0 then freeze(24,cur,8) end
 elseif home==#horses then
  results=true
  res_t=0
 end
end

function cprint(s,y,c)
 print(s,64-#s*2,y,c)
end

function draw_results()
 cls(1)
 if cur>=#levels then
  cprint("all "..#levels.." races run",44,7)
  cprint("falls: "..deaths,60,8)
  cprint("press x to run again",84,5)
 else
  cprint("race "..cur.." clear",44,7)
  cprint("falls: "..deaths,60,8)
  cprint("press x for race "..(cur+1),84,5)
 end
end

function _draw()
 if results then
  draw_results()
  return
 end

 cls()
 map(lvl.x,lvl.y,0,0,lvl_w,lvl_h)
 for h in all(horses) do h_draw(h) end

 -- control hint on the level a horse joins, until they use the key
 for h in all(horses) do
  if h.def.from==cur and not h.used then
   print(h.def.hint,4,120,7)
  end
 end

 if pause_t>18 then
  rectfill(0,0,127,127,pause_col)
 end

 print("lvl "..cur.."  falls "..deaths,4,2,7)
 if practice then print("practice",4,121,6) end
 if autopl then print("auto",104,121,11) end
end
-->8
-- horses --

lane_h=4     -- map rows per lane. 4 lanes x 4 rows = 16

-- lane is this table's order: red on top, then blue, green, orange.
-- from = first level this horse appears on
-- hold = gravity is flipped only while the key is held
-- sfx  = this horse's looping track, played on channel chan
--        red must stay on channel 0: it is always present, and
--        channel 0 is what stat(20) reads for the beat.
-- hint = shown on the joining level until the key is first used.
--        if the arrow glyphs paste as garbage, use the words
--        "left" / "down" / "right" / "x" instead.
hdefs={
 {spr=1,key=0,pulse=8, from=1,hold=false,sfx=1,chan=0,
  hint="press ⬅️ to giddy-up/down"},                     -- red
 {spr=3,key=3,pulse=12,from=3,hold=false,sfx=2,chan=1,
  hint="press ⬇️ to giddy-up/down"},                     -- blue
 {spr=5,key=1,pulse=11,from=6,hold=false,sfx=0,chan=2,
  hint="press ➡️ to giddy-up/down"},                     -- green
 {spr=7,key=5,pulse=9, from=8,hold=true, sfx=3,chan=3,
  hint="hold ❎ to hang around"}                          -- orange
}

function make_horses(lv)
 horses={}
 for i=1,#hdefs do
  local d=hdefs[i]
  if lv>=d.from then
   add(horses,{def=d,lane=i-1,x=0,flipped=false,
               dead=false,used=false,auto=false})
  end
 end
end

function h_top(h) return h.lane*lane_h end

function h_y(h)
 if h.flipped then return h_top(h)+1 end
 return h_top(h)+lane_h-2
end

function h_hit(h)
 return fget(mget(lvl.x+h.x, lvl.y+h_y(h)),0)
end

-- autopilot: flip if the cell we're about to land on is solid
function h_auto(h)
 local nx=h.x+1
 if nx>=lvl_w then return end
 if fget(mget(lvl.x+nx, lvl.y+h_y(h)),0) then
  h.flipped=not h.flipped
 end
end

function h_update(h,beat)
 local d=h.def

 if not h.auto then
  if btn(d.key) then h.used=true end
  -- toggle horses: one press inside the window
  if window and not d.hold and btnp(d.key) then
   h.flipped=not h.flipped
  end
 end

 if beat then
  if h.auto then h_auto(h) end
  h.x+=1
  -- hold horse: whatever the key is doing on the beat is the new state
  if not h.auto and d.hold then h.flipped=btn(d.key) end
 end
end

function h_draw(h)
 local px,py=h.x*8,h_y(h)*8
 spr(h.def.spr,px,py,1,1,false,h.flipped)

 if h.dead then
  line(px,py,px+7,py+7,8)
  line(px+7,py,px,py+7,8)
 end
end

