pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- buoyancy -- v7
-- LEVEL LIVES IN THE MAP EDITOR.
-- draw tiles, press run. no code edits.
--
-- 1 solid   2 soft    3 medium
-- 4 hard    5 bomb    6 goal
-- 7 checkpoint        8 spawn
-- anything else = empty air
--
-- to retune a material, change tdef.
-- to add one, draw a new sprite and
-- add a tdef line for its number.

tdef={}
tdef[1]={s=true}
tdef[2]={t=1}
tdef[3]={t=2.5}
tdef[4]={t=4.5}
tdef[5]={hz=true}
tdef[6]={gl=true}
tdef[7]={cp=true}
tdef[8]={sp=true}

cfg={m0=0.2,k=0.35,g=0.3,
     buoy=0.281,thr=0.2,drg=0.014,
     zoom=0.5}
pn={"m0","k","g","buoy","thr","drg","zoom"}
pstp={0.02,0.02,0.02,0.008,0.02,0.002,0.125}

ts=16 cs=32 psz=6
zm=0.5 camx=0 camy=0 sox=0 soy=0

function _init()
 zm=cfg.zoom mklvl() hard_reset()
 tune=false sel=1 shk=0 fr=0
 mode="title" bcost=0
end

function ab(x,y,w,h,t,hz,n,px,py)
 local b={x=x,y=y,w=w,h=h,t=t or 0,
   hz=hz,spr=n,px=px or x,py=py or y}
 add(blocks,b) return b
end

function mklvl()
 blocks={} goals={} cps={}
 mw,mh=1,1
 for ty=0,31 do
  for tx=0,127 do
   if mget(tx,ty)>0 then
    mw=max(mw,tx+1) mh=max(mh,ty+1)
   end
  end
 end
 lw,lh=mw*ts,mh*ts
 spawn={x=ts+5,y=ts+5}
 for ty=0,mh-1 do
  for tx=0,mw-1 do
   local n=mget(tx,ty)
   local d=tdef[n]
   if d then
    local x,y=tx*ts,ty*ts
    if d.s then ab(x,y,ts,ts,0,false,n)
    elseif d.t then
     ab(x,y,ts,ts,d.t,false,n)
    elseif d.hz then
     ab(x+4,y+4,8,8,0,true,n,x,y)
    elseif d.gl then
     add(goals,{x=x,y=y,w=ts,h=ts,spr=n})
    elseif d.cp then
     add(cps,{x=x+8,y=y+5,spr=n})
    elseif d.sp then
     spawn={x=x+5,y=y+5}
    end
   end
  end
 end
 -- invisible box so you cannot leave
 ab(-ts,-ts,lw+ts*2,ts)
 ab(-ts,lh,lw+ts*2,ts)
 ab(-ts,0,ts,lh)
 ab(lw,0,ts,lh)
 mkgrid() mkbub()
end

-- ambient upward drift: the air
-- pressure you are floating in.
function mkbub()
 bubs={}
 local vw=128/zm
 for i=1,60 do
  local b={}
  respawn(b)
  b.x=spawn.x-vw/2+rnd(vw)
  b.y=spawn.y-vw/2+rnd(vw)
  add(bubs,b)
 end
end

function respawn(b)
 local vw,vh=128/zm,128/zm
 b.x=camx+rnd(vw)
 b.y=camy+vh+rnd(12)
 b.v=0.5+rnd(1.7)
 b.ph=rnd(1)
 local r=rnd(1)
 b.c=r<0.25 and 12 or (r<0.7 and 13 or 1)
end

function updbub()
 local vw,vh=128/zm,128/zm
 for b in all(bubs) do
  b.y-=b.v
  if b.y<camy-6
  or b.x<camx-10
  or b.x>camx+vw+10 then respawn(b) end
 end
end

function gk(cx,cy) return cx+cy*256 end

function mkgrid()
 grid={}
 for b in all(blocks) do
  for cx=flr(b.x/cs),flr((b.x+b.w-1)/cs) do
   for cy=flr(b.y/cs),flr((b.y+b.h-1)/cs) do
    local k=gk(cx,cy)
    grid[k]=grid[k] or {}
    add(grid[k],b)
   end
  end
 end
end

function hard_reset()
 cp={x=spawn.x,y=spawn.y}
 deaths=0 tmr=0
 for b in all(blocks) do b.dead=false end
 for c in all(cps) do c.got=false end
 reset()
end

function reset()
 p={x=cp.x,y=cp.y,vx=0,vy=0,m=cfg.m0}
 trail={} parts={} dtm=0
 won=false brk=0 msgt=0
end

-->8
-- update

function cel(v) return -flr(-v) end

function _update60()
 fr+=1
 if mode=="title" then
  camx=0 camy=0 sox=0 soy=0
  updbub()
  if btnp(4) or btnp(5) then
   mode="play" hard_reset()
  end
  return
 end
 if btnp(5) then tune=not tune end
 if tune then tunepanel()
 else
  if btnp(4) then reset() end
  if dtm>0 then
   dtm-=1
   if dtm==0 then reset() end
  elseif not won then
   physics()
   local n=mid(1,cel(max(abs(p.vx),
     abs(p.vy))/2),8)
   for i=1,n do movex(1/n) movey(1/n) end
   checkhz() checkcp() tmr+=1
   for gl in all(goals) do
    if not won
    and ovl(p.x,p.y,psz,psz,gl) then
     win()
    end
   end
  end
 end
 updbub()
 if msgt>0 then msgt-=1 end
 shk*=0.85
 add(trail,{x=p.x,y=p.y,m=p.m})
 if #trail>16 then deli(trail,1) end
 for i=#parts,1,-1 do
  local q=parts[i]
  q.x+=q.vx q.y+=q.vy
  q.vy+=0.12 q.l-=1
  if q.l<0 then deli(parts,i) end
 end
end

function win()
 won=true
 sfx(3)
end

function physics()
 local sp=sqrt(p.vx*p.vx+p.vy*p.vy)
 p.m=cfg.m0+cfg.k*sp
 local fx,fy=0,0
 if btn(0) then fx-=cfg.thr end
 if btn(1) then fx+=cfg.thr end
 fy+=cfg.g*p.m
 fy-=cfg.buoy
 fx-=cfg.drg*p.vx*sp
 fy-=cfg.drg*p.vy*sp
 p.vx+=fx/p.m
 p.vy+=fy/p.m
end

function ovl(x,y,w,h,b)
 return x+w>b.x and x<b.x+b.w
    and y+h>b.y and y<b.y+b.h
end

function near(x,y,wanthz)
 local r={}
 for cx=flr(x/cs),flr((x+psz-1)/cs) do
  for cy=flr(y/cs),flr((y+psz-1)/cs) do
   local g=grid[gk(cx,cy)]
   if g then
    for b in all(g) do
     if not b.dead
     and (b.hz==true)==wanthz
     and ovl(x,y,psz,psz,b) then
      add(r,b)
     end
    end
   end
  end
 end
 return r
end

function hitall(x,y)
 return near(x,y,false)
end

function checkhz()
 if #near(p.x,p.y,true)>0 then die() end
end

function checkcp()
 for c in all(cps) do
  local bx,by=c.x-8,c.y-5
  if not c.got
  and p.x+psz>bx and p.x<bx+ts
  and p.y+psz>by and p.y<by+ts then
   c.got=true cp={x=c.x,y=c.y}
   msgt=100 sfx(7)
   for i=1,10 do
    add(parts,{x=c.x,y=c.y,
     vx=rnd(2)-1,vy=-rnd(2),
     l=14+rnd(10),c=11})
   end
  end
 end
end

function die()
 dtm=20 deaths+=1 shk=9 sfx(2)
 for i=1,18 do
  add(parts,{x=p.x+3,y=p.y+3,
   vx=rnd(4)-2,vy=rnd(4)-2.5,
   l=12+rnd(10),
   c=rnd(1)<0.5 and 8 or 9})
 end
end

function burst(c)
 for i=1,5+bcost*2 do
  add(parts,{x=p.x+3,y=p.y+3,
   vx=rnd(3)-1.5,vy=rnd(3)-1.5,
   l=8+rnd(8),c=c})
 end
end

function resolve(hs,mom)
 local cost,soft=0,true
 for b in all(hs) do
  if b.t>0 then cost=max(cost,b.t)
  else soft=false end
 end
 if soft and mom>=cost then
  for b in all(hs) do b.dead=true end
  bcost=cost
  return mom-cost
 end
end

-- brittle -> crunch -> concrete
function brksfx()
 if bcost>=4 then sfx(6)
 elseif bcost>=2 then sfx(5)
 else sfx(4) end
end

function movex(f)
 local d=p.vx*f
 local nx=p.x+d
 local hs=hitall(nx,p.y)
 if #hs<1 then p.x=nx return end
 local nm=resolve(hs,p.m*abs(p.vx))
 if nm then
  p.vx=(d>0 and 1 or -1)*nm/p.m
  p.x=nx brk=8
  shk=3+bcost burst(11) brksfx()
 else
  if d>0 then
   local e=lw
   for b in all(hs) do e=min(e,b.x) end
   p.x=e-psz
  else
   local e=-999
   for b in all(hs) do e=max(e,b.x+b.w) end
   p.x=e
  end
  p.vx=0
 end
end

function movey(f)
 local d=p.vy*f
 local ny=p.y+d
 local hs=hitall(p.x,ny)
 if #hs<1 then p.y=ny return end
 local nm=resolve(hs,p.m*abs(p.vy))
 if nm then
  p.vy=(d>0 and 1 or -1)*nm/p.m
  p.y=ny brk=8
  shk=4+bcost*1.2 burst(10) brksfx()
 else
  if d>0 then
   local e=lh
   for b in all(hs) do e=min(e,b.y) end
   p.y=e-psz
  else
   local e=-999
   for b in all(hs) do e=max(e,b.y+b.h) end
   p.y=e
  end
  p.vy=0
 end
end

function tunepanel()
 if btnp(2) then sel-=1 end
 if btnp(3) then sel+=1 end
 sel=((sel-1)%#pn)+1
 local n=pn[sel]
 if btnp(0) then cfg[n]-=pstp[sel] end
 if btnp(1) then cfg[n]+=pstp[sel] end
 if n=="zoom" then
  cfg.zoom=mid(0.25,cfg.zoom,1)
  zm=cfg.zoom
 else
  cfg[n]=max(cfg[n],0.002)
 end
 if btnp(4) then reset() end
end

-->8
-- draw

-- weight bands: drive colour + sound
function mtier(m)
 local c=cfg.buoy/cfg.g
 if m<c*0.75 then return 1
 elseif m<c then return 2
 elseif m<c*1.7 then return 3
 elseif m<c*2.6 then return 4 end
 return 5
end

tcol={12,7,10,9,8}
function mcol(m) return tcol[mtier(m)] end

function sx(wx) return (wx-camx)*zm+sox end
function sy(wy) return (wy-camy)*zm+soy end

function box(wx,wy,ww,wh,c)
 local x0,y0=flr(sx(wx)),flr(sy(wy))
 local x1=max(x0,flr(sx(wx+ww))-1)
 local y1=max(y0,flr(sy(wy+wh))-1)
 rectfill(x0,y0,x1,y1,c)
end

-- draw a map sprite into a world tile
function tspr(n,wx,wy)
 local d=max(1,flr(ts*zm))
 local sxp=(n%16)*8
 local syp=flr(n/16)*8
 sspr(sxp,syp,8,8,flr(sx(wx)),
   flr(sy(wy)),d,d)
end

function _draw()
 if mode=="title" then title() return end
 cls(0)
 local vw,vh=128/zm,128/zm
 camx=mid(0,p.x+3-vw/2,max(0,lw-vw))
 camy=mid(0,p.y+3-vh/2,max(0,lh-vh))
 sox,soy=0,0
 if shk>0.4 then
  sox=rnd(shk)-shk/2
  soy=rnd(shk)-shk/2
 end
 camera(0,0)

 drawbub()

 for c in all(cps) do
  if not c.got then tspr(7,c.x-8,c.y-5) end
 end
 for gl in all(goals) do
  if fr%20<14 then tspr(gl.spr,gl.x,gl.y)
  else box(gl.x,gl.y,gl.w,gl.h,11) end
 end

 for cx=flr(camx/cs),flr((camx+vw)/cs) do
  for cy=flr(camy/cs),flr((camy+vh)/cs) do
   local g=grid[gk(cx,cy)]
   if g then
    for b in all(g) do
     if not b.dead and b.spr then
      tspr(b.spr,b.px,b.py)
     end
    end
   end
  end
 end

 for i=1,#trail do
  if i%2==0 then
   local t=trail[i]
   pset(sx(t.x+3),sy(t.y+3),mcol(t.m))
  end
 end
 for q in all(parts) do
  pset(sx(q.x),sy(q.y),q.c)
 end

 if dtm<=0 then
  box(p.x,p.y,psz,psz,mcol(p.m))
  pset(sx(p.x+3),sy(p.y+3),7)
  if brk>0 then
   circ(sx(p.x+3),sy(p.y+3),
     (11-brk)*zm,7) brk-=1
  end
 end
 hud()
end

function drawbub()
 for b in all(bubs) do
  local bx=sx(b.x+sin(b.y/64+b.ph)*3)
  local by=sy(b.y)
  pset(bx,by,b.c)
  if b.v>1.4 then pset(bx,by+1,b.c) end
 end
end

function title()
 cls(0)
 drawbub()
 rectfill(0,42,127,74,0)
 print("\^w\^tbuoyancy",32,48,12)
 print("speed is weight",34,64,6)
 if fr%40<26 then
  print("\151 to start",42,98,7)
 end
 print("\139\145 thrust   \142 retry",21,112,5)
end

function hud()
 local crit=cfg.buoy/cfg.g
 local function gx(m)
  return mid(2,2+m*22,80)
 end
 rectfill(1,2,81,10,0)
 rect(2,3,80,9,5)
 rectfill(3,4,gx(p.m),8,mcol(p.m))
 line(gx(crit),3,gx(crit),9,7)
 if msgt>0 and not won then
  local c=(msgt<20 and msgt%6<3) and 3 or 11
  rectfill(25,100,102,108,0)
  print("checkpoint reached",28,102,c)
 end
 if won then
  rectfill(24,54,104,76,0)
  rect(24,54,104,76,11)
  print("cleared",46,60,11)
  print(flr(tmr/60).."."..flr(tmr/6)%10
    .."s  "..deaths.." deaths",30,68,7)
 end
 if tune then
  rectfill(0,58,62,127,0)
  rect(0,58,62,127,5)
  for i=1,#pn do
   local y=60+i*8
   print(pn[i],4,y,i==sel and 7 or 5)
   print(cfg[pn[i]],30,y,
     i==sel and 10 or 5)
  end
  print("crit spd",4,120,6)
  print((crit-cfg.m0)/cfg.k,40,120,12)
 end
end
