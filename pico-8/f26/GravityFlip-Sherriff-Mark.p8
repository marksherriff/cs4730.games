pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	gravity=0.25
	max_levels=2
	level=1
	game_over=false
	reset_player()
end

function reset_player()
	gravity=0.25
	player={x=8,y=112,w=6,h=8,dx=0,dy=0,flip=false}
end

function _update()
	if game_over then
		if btnp(5) then
			level=1
			game_over=false
			reset_player()
		end
		return
	end

	if btnp(5) then
		gravity=-gravity
		player.dy=0
	end

	player.dx=0
	if btn(0) then
		player.dx=-1.2
		player.flip=false
	end
	if btn(1) then
		player.dx=1.2
		player.flip=true
	end

	move_x()
	player.dy=mid(-3.5,player.dy+gravity,3.5)
	move_y()

	if touches_exit() then
		if level<max_levels then
			level+=1
			reset_player()
		else
			game_over=true
		end
	end
end

function move_x()
	player.x+=player.dx
	if player.dx>0 then
		local tx=flr((player.x+player.w-1)/8)
		for ty=flr(player.y/8),flr((player.y+player.h-1)/8) do
			if solid_tile(tx,ty) then
				player.x=tx*8-player.w
			end
		end
	elseif player.dx<0 then
		local tx=flr(player.x/8)
		for ty=flr(player.y/8),flr((player.y+player.h-1)/8) do
			if solid_tile(tx,ty) then
				player.x=(tx+1)*8
			end
		end
	end
end

function move_y()
	player.y+=player.dy
	if player.dy>0 then
		local ty=flr((player.y+player.h-1)/8)
		for tx=flr(player.x/8),flr((player.x+player.w-1)/8) do
			if solid_tile(tx,ty) then
				player.y=ty*8-player.h
				player.dy=0
			end
		end
	elseif player.dy<0 then
		local ty=flr(player.y/8)
		for tx=flr(player.x/8),flr((player.x+player.w-1)/8) do
			if solid_tile(tx,ty) then
				player.y=(ty+1)*8
				player.dy=0
			end
		end
	end
end

function solid_tile(tx,ty)
	return tx<0 or tx>=16 or ty<0 or ty>=16
		or fget(mget(level*16-16+tx,ty),0)
end

function touches_exit()
	for ty=flr(player.y/8),flr((player.y+player.h-1)/8) do
		for tx=flr(player.x/8),flr((player.x+player.w-1)/8) do
			if fget(mget(level*16-16+tx,ty),1) then
				return true
			end
		end
	end
	return false
end

function _draw()
	cls(1)
	draw_level()

	if game_over then
		rectfill(18,53,109,75,0)
		rect(18,53,109,75,7)
		print("game over",43,59,11)
		print("you won!",45,67,7)
		print("x: restart",40,75,7)
	else
		draw_player()
	end
end

function draw_level()
	for ty=0,15 do
		for tx=0,15 do
			local tile=mget(level*16-16+tx,ty)
			if tile>0 then
				spr(tile,tx*8,ty*8)
			end
		end
	end
end

function draw_player()
	spr(0,player.x,player.y,1,1,player.flip,gravity<0)
end
