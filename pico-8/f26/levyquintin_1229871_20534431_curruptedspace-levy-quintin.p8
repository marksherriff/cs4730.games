pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	
	-- right now not used
	screen = "title"

	levels = {}
	levels[1] = {unlocked=true, completed=false}
	for i=2,8 do
		levels[i] = {unlocked=false, completed=false}
	end

	cursor = 1
	current_level = 1
	

	-- level data for planet layout
	level_data = {}
	-- level 1
	-- To Add
	-- 		Star collectable
	-- 		moving enemy alien collidable [delay this]
	-- 		give planets a sprite index

	-- level 1 - learn to aim the ship
	level_data[1] = {
		start = {x=30, y=64},
		planets = {
			--{x=80, y=80, r=8, str=0.20, freq=0.005, phase=0},
		},
		goal = {x=90, y=64, r=8},
		star = {x=60, y=64, r=4, hit=false, bonus=false},
	}
	-- level 2 - learn to increase power for ship
	level_data[2] = {
		start = {x=20, y=64},
		planets = {
			{x=64, y=40, r=8, str=0.30, freq=0.005, phase=0, ver=0},
		},
		goal = {x=100, y=64, r=8},
		star = {x=64, y=76, r=4, hit=false, bonus=false},
	}
	-- level 3 - learn how to wait for synchronization
	level_data[3] = {
		start = {x=64, y=110},
		planets = {
			{x=40, y=64, r=8, str=0.30, freq=0.005, phase=1.5707, ver=1},
			{x=88, y=64, r=8, str=0.30, freq=0.010, phase=0, ver=1}
		},
		goal = {x=64, y=24, r=8},
		star = {x=24, y=64, r=4, hit=false, bonus=false}
	}

	-- level 4 - Learn how to curve around enemy
	level_data[4] = {
		start = {x=110, y=14},
		planets = {
			{x=54, y=36, r=8, str=0.30, freq=0.050, phase=0, ver=1},
			{x=80, y=80, r=8, str=0.30, freq=0.005, phase=1.5707, ver=1}
		},
		goal = {x=16, y=96, r=8},
		star = {x=96, y=96, r=4, hit=false, bonus=false}, 
	}

	level_data[5] = {
		start = {x=16, y=96},
		planets = {
			{x=40, y=48, r=8, str=0.30, freq=0.010, phase=0, ver=0},
			{x=88, y=48, r=8, str=0.30, freq=0.010, phase=0, ver=0},
			{x=64, y=80, r=8, str=0.20, freq=0.030, phase=0, ver=1}
		},
		goal = {x=64, y=24, r=8},
		star = {x=64, y=56, r=4, hit=false, bonus=false}, 
	}

	level_data[6] = {
		start = {x=112, y=64},
		planets = {
			{x=56, y=32, r=8, str=0.20, freq=0.010, phase=1.5707, ver=0},
			{x=56, y=64, r=8, str=0.20, freq=0.010, phase=0, ver=1},
			{x=56, y=96, r=8, str=0.20, freq=0.010, phase=1.5707, ver=0},

		},
		goal = {x=16, y=32, r=8},
		star = {x=40, y=72, r=4, hit=false, bonus=false}, 
	}

	level_data[7] = {
		start = {x=16, y=112},
		planets = {
			{x=40, y=40, r=8, str=0.20, freq=0.010, phase=1.5707, ver=0},
			{x=40, y=88, r=8, str=0.20, freq=0.010, phase=0, ver=1},
			{x=88, y=88, r=8, str=0.20, freq=0.010, phase=1.5707, ver=0},

		},
		goal = {x=96, y=32, r=8},
		star = {x=40, y=72, r=4, hit=false, bonus=false}, 
	}

	-- level 8 - final wrap around
	level_data[8] = {
		start = {x=112, y=32},
		planets = {
			{x=64, y=16, r=8, str=0.30, freq=0.030, phase=1.5707, ver=0},
			{x=64, y=32, r=8, str=0.30, freq=0.006, phase=1.5707, ver=0},
			{x=96, y=64, r=8, str=0.30, freq=0.003, phase=0, ver=1},
			{x=64, y=96, r=8, str=0.30, freq=0.006, phase=1.5707, ver=0},
			{x=32, y=64, r=8, str=0.30, freq=0.003, phase=0, ver=1}

		},
		goal = {x=32, y=32, r=8},
		star = {x=64, y=64, r=4, hit=false, bonus=false}, 
	}

	startx,starty = level_data[1].start.x, level_data[1].start.y
	earth={x=startx,y=starty,vx=0,vy=0,r=3}

	t=0
	state="aim"
	
	
	-- aim_angle logic
	-- 0.50 = left
	-- 0.75 = forward
	-- 1.00 = right
	-- clamp to [0.5,1.0]
	aim_angle = 0.75
	aim_speed = 0.006
	
	pow = 1.2
	minpow = 1.0
	maxpow = 5.0
	powspeed = 0.05
	
	
	-- ranfe at which a planet
	-- affects the earth/player
	influence=42


	-- particles logic
	particles = {}
	for i=1,24 do
		add(particles,{active=false})
	end

end

-- current gravity value of
-- a planet at a time tt
function planet_g(p,tt)
	return p.str * sgn(cos(tt * p.freq + p.phase))
end


-- total accleration for point
-- (x,y) at time tt
function grav_accel(x,y,tt)
	local ax,ay = 0,0
	for p in all(planets) do
	
		-- difference between planet and point
		local dx,dy = p.x-x, p.y-y
		-- get distance magnitude
		local d = sqrt(dx*dx + dy*dy)
		
		-- if within range of influence
		if d<influence and d>2 then
			local g = planet_g(p,tt)
			-- force falls off with disance
			local f = g/d 
			ax += f*dx
			ay += f*dy
		end
	end
	
	return ax, ay
	
end

-- update function manager
function _update()
	t+=1
	if screen == "title" then
		update_title()
		if t==1 then sfx(9) end
	elseif screen == "story" then
		update_story()
		if t==1 then sfx(10) end
	elseif screen == "levelselect" then
		update_levelselect()
	elseif screen == "game" then 
		update_game()
	end
end

-- draw function manager
function _draw() 
	if screen == "title" then
		draw_title()
	elseif screen == "story" then
		draw_story()
	elseif screen == "levelselect" then
		draw_levelselect()
	elseif screen == "game" then 
		draw_game()
	end
end


-- title logic
function update_title()
	if btnp(4) or btnp(5) then
		sfx(4)
		screen = "story"
		t=0
	end
end

function draw_title()
	cls(0)
	--map(4,0,0,0,16,16)
	--map(4,0,64,0,16,16)
	--map(4,0,0,0,8,8)
	print("currupted space",33,50,7)
	print("press x to start",32,70,6)
end


-- story screen logic
function update_story()
	if btnp(4) or btnp(5) then
		sfx(4)
		screen = "levelselect"
	end
end

function draw_story()
	cls()
	print("A traveler sails into the dark.", 0, 20, 7)
	print("gravity itself corrupted by", 0, 30, 7)
	print("monsters spanning space & time.", 0, 40, 7)
	print("Help the lil guy prevail...", 0, 50, 7)
end


-- level select logic
function level_pos(i)
	local col = (i-1)%4
	local row = flr((i-1)/4)
	local x = 20+col*29
	local y = 40+row*40
	return x, y
end

function start_level(n)
	current_level = n
	local d = level_data[n]

	startx, starty = d.start.x, d.start.y
	planets = d.planets
	goal = d.goal
	star = d.star

	reset_earth()
	screen = "game"
end

function update_levelselect()
	-- left, right, up, down
	if btnp(0) then 
		cursor = max(1,cursor-1) 
		sfx(2)
	end 
	if btnp(1) then 
		cursor = min(8,cursor+1) 
		sfx(2)
	end
	if btnp(2) then 
		cursor = max(1,cursor-4)
		sfx(2)
	end
	if btnp(3) then 
		cursor = min(8,cursor+4) 
		sfx(2)
	end

	if btnp(4) then
		if levels[cursor].unlocked then
			sfx(4)
			start_level(cursor)
		else
			sfx(3)
		end
	end
end

function draw_levelselect()
	cls(1)
	print("select level", 44, 10, 7)

	for i=1,8 do
		local x,y = level_pos(i)
		local lv = levels[i]
		local c = lv.unlocked and 12 or 5 

		circfill(x,y,10,c) 
		if i== cursor then
			-- selection highlight
			-- blue = unlocked, dark grey = locked
			circ(x,y,11,7) 
		end
		print(i,x-2,y-2,lv.unlocked and 7 or 1)

		-- status dot slot (collectables later?)
		-- lights up when achieved
		local dotc = lv.bonus and 9 or 0
		circfill(x+7,y+7,2,dotc)
		circ(x+7,y+7,2,1)
	end
end

function complete_level()
	levels[current_level].completed = true

	-- bonus star collected?
	if star and star.hit then
		levels[current_level].bonus = true
	end

	-- unlock next level
	if current_level < 8 then
		levels[current_level + 1].unlocked = true
	end
	screen = "levelselect"
end


-- gameplay loop update manager
function update_game()

	update_particles()
	if state == "aim" then
		update_aim()
	elseif state == "fly" then
		update_fly()
	elseif state == "dead" then
		if btnp(4) then
			reset_earth()
		end
		if btnp(5) then
			quit_level()
		end
	elseif state == "win" then
		if btnp(4) then 
			complete_level()
		end
	end
end 

-- update for aim state
function update_aim()
	-- aim left
	if btn(0) then aim_angle -= aim_speed end
	-- aim right
	if btn(1) then aim_angle += aim_speed end
	-- clamp aim angle
	aim_angle = aim_angle % 1
	
	-- up
	if btn(2) then pow=min(pow+powspeed, maxpow) end
	-- down
	if btn(3) then pow=max(pow-powspeed, minpow) end

	-- lauch command!
	if btnp(4) then
		launch_earth()
	end
	
	if btnp(5) then
		quit_level()
	end
end

function quit_level()
	screen = "levelselect"
end


-- launch the earth!
function launch_earth()
	earth.vx = cos(aim_angle)*pow
	earth.vy = -sin(aim_angle)*pow
	state = "fly"
	sfx(6)
end


-- game update logic for fly state
function update_fly()

	-- calculate acceleration
	local ax,ay = grav_accel(earth.x, earth.y, t)
	
	--update velocity
	earth.vx += ax
	earth.vy += ay
	
	-- update p[osition
	earth.x += earth.vx
	earth.y += earth.vy
	
	-- check for planet collision
	for p in all(planets) do
		local dx,dy = p.x-earth.x, p.y-earth.y
		-- die if collision
		if sqrt(dx*dx + dy*dy) < p.r+earth.r then
			state = "dead"
			sfx(1) -- fail sound
		end
	end

	-- check for star collectable
	local sx,sy = earth.x-star.x, earth.y-star.y
	if not star.hit and sqrt(sx*sx + sy*sy) < star.r+earth.r then
		star.hit = true
		sfx(5)
	end
	
	-- check for end of screen coll.
	if earth.x<-8 or earth.x>136 or earth.y<-8 or earth.y>136 then
		state = "dead"
		sfx(1) --fail sound
	end
	
	-- check if player has reached goal
	local gx,gy = goal.x-earth.x, goal.y-earth.y
	if sqrt(gx*gx + gy*gy) < goal.r+earth.r then
		sfx(0) -- win sfx
		state = "win"
	end	
end

-- earth/game state reset
function reset_earth()
	t = 0
	earth.x,earth.y = startx,starty
	earth.vx,earth.vy = 0,0
	state = "aim"
	if star then star.hit = false end
end


function draw_game()
	cls()
	for i=0,3 do
		for j=0,3 do
			map(0,0,i*32,j*32,4,4)
		end
	end
	-- draw goal
	local goal_spr = (flr(t/15)%2==0) and 36 or 38
	spr(goal_spr,goal.x-8,goal.y-8, 2, 2)
	--circfill(goal.x,goal.y,goal.r,11)
	--circ(goal.x,goal.y,goal.r+2,3)
	
	-- draw planets
	for p in all(planets) do
		local g = planet_g(p,t)
		-- what??
		local c = g>=0 and 12 or 8
		--circfill(p.x,p.y,p.r,c)
		--circ(p.x,p.y,p.r+1,1)
		
		if p.ver == 0 then
			if g>0 then
				spr(12,p.x-8,p.y-8,2,2)
			else
				spr(44,p.x-8,p.y-8,2,2)
			end
		else 
			if g>0 then
				spr(14,p.x-8,p.y-8,2,2)
			else
				spr(46,p.x-8,p.y-8,2,2)
			end
		end
		
	end

	draw_particles()
	
	-- aiming ui
	if state == "aim" then
		--draw_trajectory()
		draw_aim_arrow()
	end
	
	-- draw earth
	--circfill(earth.x, earth.y, earth.r, 7)
	--circ(earth.x, earth.y, earth.r, 6) (3)
	spr(35,earth.x-4,earth.y-4)

	-- draw collectable star
	if star and not star.hit then
		spr(19, star.x-4, star.y-4)
	end

	print_state()	
end


-- short line for aim/power
function draw_aim_arrow()
	local len = 6+pow*6
	local ex = earth.x + cos(aim_angle) * len
	local ey = earth.y - sin(aim_angle) * len
	line(earth.x, earth.y, ex, ey, 10)
end	


-- simulate ahead
-- preview of launch
function draw_trajectory()
	-- init loc param
	-- simulated vaules for path projection
	local sx,sy = earth.x,earth.y
	local svx,svy = cos(aim_angle)*pow,-sin(aim_angle)*pow
	local st=t

	local maxforce = 0.6
	
	for i=1, 40 do
		local ax,ay = grav_accel(sx,sy,st)
		svx -= ax * 4
		svy -= ay * 4
		sx+=svx
		sy+=svy
		st+=1
		
		if i%2==0 then
			pset(sx,sy,7)
		end
	end
	
end

-- particle logic
function spawn_particles(p,g)
	for pt in all(particles) do
		if not pt.active then
			local ang = rnd(1)
			local speed = 1.5

			if g>=0 then
				-- pulling inwards
				local dist = p.r+10
				pt.x = p.x + cos(ang) * dist
				pt.y = p.y + sin(ang) * dist
				pt.vx = -cos(ang) * speed
				pt.vy = -sin(ang) * speed
				pt.col = 6
			else
				-- pushing outwards
				local dist = p.r + 1
				pt.x = p.x + cos(ang) * dist
				pt.y = p.y + sin(ang) * dist
				pt.vx = cos(ang) * speed
				pt.vy = sin(ang) * speed
				pt.col = 6
			end

			pt.life = 10
			pt.active = true

			return
		end
	end
end

function update_particles()

	-- for every particle
	for pt in all(particles) do
		if pt.active then
			pt.x+=pt.vx
			pt.y+=pt.vy
			pt.life-=1; -- particles die
			if pt.life<=0 then
				pt.active = false
			end
		end
	end

	for p in all(planets) do
		local g = planet_g(p,t)
		if rnd(1) < 0.5 then
			spawn_particles(p,g)
		end
	end
end

function draw_particles() 
	for pt in all(particles) do
		if pt.active then
			pset(pt.x, pt.y, pt.col)
		end
	end
end



function print_state()
	if state=="dead" then
		print("crashed - x: retry | o: quit",4,4,8)
	elseif state=="win" then
		print("congradulations! x to continue",4,4,11)
	else
		print("l/r: aim | up/down: power",2,4,6)
		print("x: launch | o: quit",2,10,6)
	end
end
