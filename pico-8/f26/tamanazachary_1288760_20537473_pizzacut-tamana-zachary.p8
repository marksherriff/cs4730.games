pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--zachary tamana
--edy7qm
--chatgpt
player = {
 x = 10,
 y = 55,
 dx = 0,
 dy = 0,
 speed = 1.5,
}

won = false

function reset_player()
 player.x = 10
 player.y = 55
 player.dx = 0
 player.dy = 0
 player.on_ground = false
end

function _update()

 -- restart after winning
 if won then
  if btnp(4) then
   won=false
   reset_player()
  end
  return
 end

 -- horizontal movement
 if btn(0) then
  player.dx=-player.speed
 elseif btn(1) then
  player.dx=player.speed
 else
  player.dx=0
 end

 -- up only
 if btn(2) then
  player.dy=-player.speed
 else
  player.dy=0
 end

 -- move player
 player.x += player.dx
 player.y += player.dy

 -- keep player on screen
 if player.x < 0 then
  player.x=0
 end

 if player.x > 120 then
  player.x=120
 end

 if player.y < 0 then
  player.y=0
 end

 -- hazards
 if deadly_at(player.x,player.y)
 or deadly_at(player.x+7,player.y)
 or deadly_at(player.x,player.y+7)
 or deadly_at(player.x+7,player.y+7) then
  reset_player()
  return
 end

 -- goals
 if goal_at(player.x,player.y)
 or goal_at(player.x+7,player.y)
 or goal_at(player.x,player.y+7)
 or goal_at(player.x+7,player.y+7) then
  won=true
  return
 end

end

function deadly_at(px,py)
 local tile=mget(flr(px/8),flr(py/8))
 return fget(tile,1)
end

function goal_at(px,py)
 local tile=mget(flr(px/8),flr(py/8))
 return fget(tile,2)
end

function _draw()
 cls()
 map(0,0,0,0,16,16)

 spr(67,player.x,player.y)

 if won then
  rectfill(25,50,102,75,0)
  print("you win!",48,59,10)
  print("press z",48,67,7)
 end
end

	
	
