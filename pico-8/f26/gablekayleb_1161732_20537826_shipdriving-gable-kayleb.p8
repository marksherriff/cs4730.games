pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- main --

function _init()
plr_init()
level = 4
level_num=1   -- displayed level
game_over_state=false
game_won_state=false
died_level=1
portal_x = 40
portal_y = 6

end


function _update()
if game_won_state then
  return
 end
 
if game_over_state then
  if btnp(❎) then
   level=4
   level_num=1
   game_over_state=false
   plr_init()
  end
 else
  suck_player(portal_x,portal_y)
  suck_player(38,12)
  suck_player(53,12)
  plr_update()
  death()
  
  if collide(plr, 3) then
  	next_level()
  end
 end
end

function _draw()
 cls()
 plr_cam()
 map()
 
 draw_animation(portal_x*8,portal_y*8)
	draw_animation(38*8,12*8)
	draw_animation(53*8,12*8)
 plr_draw()

 if game_over_state then
  camera()
  rectfill(20, 42, 108, 84, 0)
  print("died on level "..died_level,32,58,8)
print("press ❎ to restart",29,72,7)
 end
 if game_won_state then
  camera()
  rectfill(20,42,108,84,0)
  print("you win!",45,50,11)
  print("level 4 complete",31,65,7)
 end
end


function plr_cam()
	camera(level, 4)
	
end

function next_level()
 level+=128
 level_num+=1

 if level_num>4 then
  game_won_state=true
  return
 end

 plr.x=level+4
 plr.y=8
 plr.xv=0
 plr.yv=0
end

function draw_animation(x,y)
 local frames={11,71,75}
 local frame=flr(time()*6)%3+1

 spr(frames[frame],x,y,4,4)
end
-->8
-- player --
function plr_init()
 plr = { x = 8, y = 8, a = 0, s = 1,w = 16,h = 16,yv = 0, xv = 0}
end

function plr_update()
	move(plr)
end

function plr_draw()
 spr(plr.s,plr.x,plr.y,plr.w/8,plr.h/8)

 -- directional sprites
 if btn(⬇️) then
  spr(64,plr.x+4,plr.y-8)
 end

 if btn(⬆️) then
  spr(66,plr.x+4,plr.y+16)
 end

 if btn(➡️) then
  spr(67,plr.x-8,plr.y+4)
 end

 if btn(⬅️) then
  spr(65,plr.x+16,plr.y+4)
 end
 

end

-->8
-- collision --
function move(o)
	local ly = o.y
	local lx = o.x
	local lxv = o.xv
	local lyv = o.yv

	
	if (btn(⬆️)) then o.yv -= .009
	end
	if (btn(⬇️)) then o.yv += .009
	end 
	if (btn(⬅️)) then o.xv -= .009
	end
	if (btn(➡️)) then o.xv += .009
	end

	o.x += o.xv
	o.y += o.yv

	-- collision/dont move --
	if collide(o, 0) then
		o.x = lx
		o.y = ly
		o.yv = 0
		o.xv = 0
	end
end

-- Game Over Function --
function game_over()
 died_level=level_num
 game_over_state=true
 plr.xv=0
 plr.yv=0
end

function death()
 if collide(plr,4) then
  game_over()
 end
end

function collide(o, f)

-- player box --
	local x1 = o.x/8
	local y1 = o.y/8
	local x2 = (o.x +13)/8
	local y2 = (o.y +13)/8
	local x3 = (o.x +8)/8
	local y3 = (o.y +8)/8
-- check for map tile flag --
-- fget gets the flag --

 local a =fget(mget(x1,y1),f)
 local b =fget(mget(x1,y2),f)
 local c =fget(mget(x2,y1),f)
 local d =fget(mget(x2,y2),f)
 local e =fget(mget(x3,y3),f)
 local g =fget(mget(x3,y1),f)
 local h =fget(mget(x3,y2),f)
 local i =fget(mget(x1,y3),f)
 local j =fget(mget(x2,y3),f)
 
 if a or b or c or d or e or g or h or i or j then
 	return true
 else
 	return false
 
 end
 
end

function suck_player(map_x,map_y)
 -- player center in map coordinates
 local px=plr.x/8+1
 local py=plr.y/8+1

 -- animated sprite center in map coordinates
 local tx=map_x+2
 local ty=map_y+2

 local dx=tx-px
 local dy=ty-py
 local dist=sqrt(dx*dx+dy*dy)

 local range=6 -- map tiles
 local kill_distance=1

 if dist<=kill_distance then
  death()
 end

 if dist>0 and dist<=range then
  plr.xv+=dx/dist*.0085
  plr.yv+=dy/dist*.0085
 end
 
 
end
