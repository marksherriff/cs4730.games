pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	boots=1
	ps=4
	psch=1
	px=8
	py=80
	spawnx=px
	spawny=py
	pfh=false
	pfv=false
	scr=0
	camx=0
	camy=0
	force=1
	jf=8
	jump=0
	acc=0.1
	over=false
	frames=0
	music(0,500)	
end

function _update()

--grav. boots--
	if btnp(🅾️) then
		boots*=-1
		sfx(1)
		if boots==1 then
			ps=4
		else
			ps=1
		end
	end

	posx=flr((px+4)/8)
	posy=flr((py+4)/8)
--hor. movement--
	if btn(➡️) then
		right=fget(mget((px+6)/8,posy))
		if (right!=4) then
			px+=1
			if psch==1 then
				ps+=1
			end
			psch*=-1
			pfh=false
			if boots==-1 then
				if ps==4 then
					ps=1
				end
			else
				if ps==6 then
					ps=4
				end
			end
		end
	end
	if btn(⬅️) then
		left=fget(mget((px+1)/8,posy))
		if (left!=4) then
			px-=1
			ps+=1
			pfh=true
			if boots==-1 then
				if ps==4 then
					ps=1
				end
			else
				if ps==6 then
					ps=4
				end
			end
		end
	end
	
	--jump--
	land=fget(mget(posx,(py+8)/8))
	up=fget(mget(posx,(py-1)/8))
	if btnp(❎) then
		acc=0.1
		if (gflip) and (boots!=1) then
			if (up==4) then
				jump=10*jf
			end
		else
			if (land==4) then
				if (boots==1) then
					jump=80
				else
					jump=10*jf
				end
			end
		end
	end
	
	if jump>0 then
		jump=jump*0.6
	end
	
	if (gflip) and (boots!=1) then
		py+=jump*acc
	else
		py-=jump*acc
	end
	if acc<1 then
		acc+=0.1
	end
	if (gflip) and (boots!=1) then
		adder=-1
	else
		adder=2
	end
	up=fget(mget(posx,(py+adder)/8))
	while (up==4) do
		py+=1
		up=fget(mget(posx,(py+adder)/8))
	end
	down=fget(mget(posx,(py+7)/8))
	while (down==4) do
		py-=1
		down=fget(mget(posx,(py+7)/8))
	end
	
	
	--gravity--
	if (gflip) and (boots!=1) then
		if (up!=4) then
			py-=force
		end
	else
		if (land!=4) then
			if (boots==1) then
				py+=1
			else
				py+=force
			end
		end
	end
	
	--get plant--
	if (fget(mget(posx,posy))==2) then
		mset(posx,posy,0)
		if(posy==8) then
			mset(posx,posy,120)
		end
		scr+=1
		sfx(0)
	end
	
	--touch wires--
	if (mget(posx,(py+6)/8)==96) then
		px=spawnx
		py=spawny
		sfx(2)
	end
	if (mget(posx,(py+6)/8)==16) then
		px=spawnx
		py=spawny
		sfx(2)
	end
	
	--touch vents--
	if (mget(posx,(py+6)/8)==101) then
		px=spawnx
		py=spawny
		sfx(3)
	end
	
	--check room--
	if (mget(posx,posy)==79) then
		camx=0
		camy=0
		jf=8
		force=1
		spawnx=px
	end
	if (mget(posx,posy)==80) then
		camx=128
		camy=0
		jf=12
		force=0.5
		spawnx=px
	end
	if (mget(posx,posy)==81) then
		camx=256
		camy=0
		jf=6
		force=1.5
		spawnx=px
		gflip=false
	end
	if (mget(posx,posy)==82) then
		camx=384
		camy=0
		jf=8
		force=1
		spawnx=px
		gflip=true
	end
	if (mget(posx,posy)==83) then
		camx=0
		camy=0
		jf=0
		force=1
		spawnx=px
		gflip=false
		over=true
		music(-1)
		sfx(13)
	end
	
	if (gflip) and (boots!=1) then
		pfv=true
	else
		pfv=false
	end
	
	if (over==false) then
		frames+=1
	end
	
	--loop music--
	if not stat(57) and (over==false) then
		music(0)
	end
	
end

function _draw()
	if (over==false) then
		cls()
		map()
		camera(camx,camy)
		spr(ps,px,py,1,1,pfh,pfv)
	 print(scr,camx+10,camy+1)
	else
		cls(1)
		camera(camx,camy)
		print("game over! you retrieved:",camx+4,camy+4)
		print(scr.." out of 13 plants",camx+4,camy+10)
		if (scr==0) then
			print("you are probably getting fired.",camx+4,camy+16)
		end
		if (scr==13) then
			print("amazing work!",camx+4,camy+16)
		end
		print("your time: "..flr(frames/30).." seconds",camx+4,camy+64)	
	end
--	print(land)
--	print(fget(mget((px+4)/8,posy)))
--	print(boots)
--	print(fget(mget(posx,(py+1)/8)))
end
