pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
level=1

px=12
py=12

vx=0
vy=0

gx=0
gy=-1

speed=1.2
gravity=.1
jump_power=5

exit_x=-100
exit_y=-100

ending_x=-100
ending_y=-100

level_map_x=0

finished=false
gravity_changed=false


function _init()
 load_level()
end


function _update()

 if finished then
  return
 end

 gravity_changed=false

 if gx==0 then

  vx=0

  if btn(0) then
   vx=-speed
  end

  if btn(1) then
   vx=speed
  end

 end


 if gy==0 then

  vy=0

  if btn(2) then
   vy=-speed
  end

  if btn(3) then
   vy=speed
  end

 end


 if touching_surface()
 and btnp(4) then

  vx=-gx*jump_power
  vy=-gy*jump_power

 end


 vx+=gx*gravity
 vy+=gy*gravity

 move_x(vx)
 move_y(vy)


 if abs(px-exit_x)<7
 and abs(py-exit_y)<7 then
  next_level()
  return
 end


 if abs(px-ending_x)<7
 and abs(py-ending_y)<7 then
  finished=true
 end

end


function _draw()

 cls(0)

 map(
  level_map_x,
  0,
  0,
  0,
  16,
  16
 )


 if not finished then

  rectfill(
   px-3,
   py-3,
   px+3,
   py+3,
   8
  )

 else

  cls(0)

  print(
   "game completed!",
   42,
   58,
   7
  )

 end

end


function load_level()

 level_map_x=(level-1)*16

 vx=0
 vy=0

 gx=0
 gy=-1

 exit_x=-100
 exit_y=-100

 ending_x=-100
 ending_y=-100


 for y=0,15 do

  for x=0,15 do

   local tile=
    mget(
     level_map_x+x,
     y
    )


   if tile==3 then

    px=x*8+4
    py=y*8+4

    mset(
     level_map_x+x,
     y,
     0
    )

   end


   if tile==2 then

    exit_x=x*8+4
    exit_y=y*8+4

   end


   if tile==4 then

    ending_x=x*8+4
    ending_y=y*8+4

   end

  end

 end

end


function next_level()

 level+=1
 load_level()

end


function wall_at(x,y)

 if x<0 or x>=128
 or y<0 or y>=128 then
  return true
 end

 local tx=flr(x/8)
 local ty=flr(y/8)

 local tile=
  mget(
   level_map_x+tx,
   ty
  )

 return tile==1

end


function blocked(x,y)

 return
  wall_at(x-3,y-3)
  or wall_at(x+3,y-3)
  or wall_at(x-3,y+3)
  or wall_at(x+3,y+3)

end


function hit_surface(dx,dy)

 if gravity_changed then
  return
 end

 if dx~=gx
 or dy~=gy then

  gx=dx
  gy=dy

  gravity_changed=true

 end

end


function move_x(amount)

 if amount==0 then
  return
 end

 local dir=sgn(amount)
 local remaining=abs(amount)

 while remaining>0 do

  local step=
   min(1,remaining)*dir

  if blocked(
   px+step,
   py
  ) then

   vx=0

   hit_surface(
    dir,
    0
   )

   return

  else

   px+=step

  end

  remaining-=abs(step)

 end

end


function move_y(amount)

 if amount==0 then
  return
 end

 local dir=sgn(amount)
 local remaining=abs(amount)

 while remaining>0 do

  local step=
   min(1,remaining)*dir

  if blocked(
   px,
   py+step
  ) then

   vy=0

   hit_surface(
    0,
    dir
   )

   return

  else

   py+=step

  end

  remaining-=abs(step)

 end

end


function touching_surface()

 return blocked(
  px+gx,
  py+gy
 )

end
