pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- gravity is broken
-- by elina

function _init()
	room=1
	coins=0
	hp=3
	state="start"
	
	reset_room()
	music(0)
end


------------------
--resets player, choose gravity, 
--set ob speed + gravity, set coin and timer
------------------
function reset_room()

 --player
	px=60
	py=60
	pw=6
	ph=8
	
	pvx=0 --hori velocity
	pvy=0 --vert velocity
	on_ground=false
	
	--gravity type
	if room==1 then
		gravity_type="down"
	else
	
		local last_gravity=gravity_type
		local new_gravity=""
		
		repeat
			local g=flr(rnd(5)) --random 
			
			if g==0 then
				gravity_type="down"
			elseif g==1 then
				gravity_type="up"
			elseif g==2 then
				gravity_type="right"
	  elseif g==3 then
	   gravity_type="left"
	  else
	   gravity_type="float down"
	  end
	  
	 until new_gravity!=last_gravity

	end
	--
	
	--obstacle
	ow=8
	oh=8
	ospeed=2+flr((room-1)/3)*0.5 --speed inc every 3 rooms
	
	obstacle_count=1+flr((room-1)/2) --cnt inc every 2 rooms
	obstacle_count=min(obstacle_count,6)
	obstacles={}
	
	for i=1, obstacle_count do
		spawn_obstacle(i)
	end

	--coin pos
	room_coins={}
	
	room_coin_total=1+flr(rnd(3)) --rand num of coins
	
	spawned_coins=0
	
	spawn_coin()
	
	coin_spawn_timer=2+flr(rnd(4)) --respawn rate
	
	
	--roomtime (s)
	room_time=10
	
	--protection after hit
	invincible=0
	
end

function _update()
	if state=="start" then
	
	--press a to start
		if btnp(4) then
			state="play"
		end
	end
 if state=="play" then
 	update_game()
 	
 elseif state=="between" then
  --btnp(5) = b on controller
  --b= spend 5 coins heal
  if btnp(5) and coins>=5 and hp<3 then
  	coins-=5
  	sfx(13)
  	hp+=1
  end
  
  --a:cont to next room
  if btnp(4) then
  	room+=1
  	state="play"
  	reset_room()
  end

 elseif state=="gameover" then

  -- press o to restart game
  if btnp(4) then
   _init()
  end

 end
end


function update_game()

 ----------------
 --movement
 ----------------

 if gravity_type=="left" then
 	if btn(0) then 
 		py-=1
 	end
 	
 	if btn(1) then
 		py+=1
 	end
 	
 	py=mid(0,py, 128-ph)
 elseif gravity_type=="right" then
 	if btn(0) then
 		py+=1
 	end
 	if btn(1) then
 		py-=1
 	end
 	
 else --vertical gravity
 	if btn(0) then
 		px-=1
 	end
 	
 	if btn(1) then
 		px+=1
 	end
 	
 	px=mid(0,px,128-pw)
 end

 -- keep player on screen
 if gravity_type=="left" or gravity_type=="right" then
 	py=mid(0,py,128-ph)
 else
 	px=mid(0,px,128-pw)
	end

 ----------------
 -- gravity
 ----------------

 if gravity_type=="down" then
	 pvy+=0.2
	elseif gravity_type=="up" then
	 pvy-=0.2
	elseif gravity_type=="right" then
	 pvx+=0.2
	elseif gravity_type=="left" then
	 pvx-=0.2
	elseif gravity_type=="float down" then
	 pvy+=0.05
	end
	
	px+=pvx
	py+=pvy


 ----------------
 -- floor
 ----------------

 on_ground=false
 
 if gravity_type=="down" or gravity_type=="float down" then
 	--floor=bottom
 	if py+ph>=112 then
 		py=112-ph
 		pvy=0
 		on_ground=true
 	end
 	
 	if py<0 then
 		py=0
 		pvy=0
 	end
 	
 elseif gravity_type=="up" then
 	--floor=top
 	if py<=8 then
 		py=8
 		pvy=0
 		on_ground=true
 	end
 
 elseif gravity_type=="right" then
 	--floor=right
 	if px+pw>=120 then
 		px=120-pw
 		pvx=0
 		on_ground=true
 	end
 	
 elseif gravity_type=="left" then
 	--floor=left
 	if px<=8 then
 		px=8
 		pvx=0
 		on_ground=true
 	end
 end

 ----------------
 --jump
 ----------------

 if btnp(4) and on_ground then
		if gravity_type=="down" or gravity_type=="float down" then
			pvy=-3.5
		elseif gravity_type=="up" then
			pvy=3.5
		elseif gravity_type=="right" then
			pvx=-3.5
		elseif gravity_type=="left" then
			pvx=3.5
		end
		sfx(16)
	end

 ----------------
 -- obstacle movement
 ----------------
	for o in all(obstacles) do
	
	 if gravity_type=="down" then
	  o.y+=ospeed
	
	  if o.y>128 then
	   reset_one_obstacle(o)
	  end
	
	 elseif gravity_type=="float down" then
	  o.y+=ospeed*0.5
	
	  if o.y>128 then
	   reset_one_obstacle(o)
	  end
	
	
	 elseif gravity_type=="up" then
	
	  o.y-=ospeed
	
	  if o.y+oh<0 then
	   reset_one_obstacle(o)
	  end
	
	
	 elseif gravity_type=="right" then
	
	  o.x+=ospeed
	
	  if o.x>128 then
	   reset_one_obstacle(o)
	  end
	
	
	 elseif gravity_type=="left" then
	
	  o.x-=ospeed
	
	  if o.x+ow<0 then
	   reset_one_obstacle(o)
	  end
	
	 end
	
	end

 ----------------
 -- obstacle collision
 ----------------
 if invincible>0 then
	 invincible-=1
	end
	
	if invincible==0 then
	
	 for o in all(obstacles) do
	
	  if collide(
	   px,py,pw,ph,
	   o.x,o.y,ow,oh
	  ) then
	
	   hp-=1
	   sfx(10)
	   invincible=30
	
	   reset_one_obstacle(o)
	
	   if hp<=0 then
	    state="gameover"
	   end
	
	   break
	  end
	
	 end
	
	end
	
 ----------------
 -- coin
 ----------------
	
	--coin spawning
	if spawned_coins<room_coin_total then
		coin_spawn_timer-=1/30
		if coin_spawn_timer<=0 then
			spawn_coin()
			coin_spawn_timer=2+flr(rnd(4))
		end
	end
	
 --coin collision
 for c in all(room_coins) do
	 if not c.taken then
	  if collide(px,py,pw,ph,
 					 c.x-3,c.y-3,6,6 ) then
	   coins+=1
	   sfx(11)
	   c.taken=true
	  end
	 end
	end

 ----------------
 -- spend coin
 ----------------

 -- x button
 -- spend 1 coin to remove
 -- 1 second from timer

 if btnp(5) and coins>0 then
  coins-=1
  room_time-=1
  sfx(12)
 end


 ----------------
 -- room timer
 ----------------

 room_time-=1/30

 if room_time<=0 then
  room_time=0
  state="between" --go to cut
  sfx(15)
 end

end


function spawn_coin()
	local cx=64
	local cy=64
	
	if gravity_type=="down" or gravity_type=="float down" then
		cx=8+rnd(112)
  cy=76+rnd(28)
	elseif gravity_type=="up" then
		cx=8+rnd(112)
  cy=16+rnd(24)
 elseif gravity_type=="right" then
  cx=88+rnd(22)
  cy=12+rnd(104)
 elseif gravity_type=="left" then
 	cx=18+rnd(22)
  cy=12+rnd(104)
 end
 
 add(room_coins, {
 	x=cx, 
 	y=cy, 
 	taken=false,
 	sprite=2+flr(rnd(2)) --sprite 2 or 3
 })
 
 spawned_coins+=1
end

function spawn_obstacle(index)
 local x=0
 local y=0

 if gravity_type=="down" or gravity_type=="float down" then
  x=rnd(120)
  y=-8-index*20

 elseif gravity_type=="up" then
  x=rnd(120)
  y=128+index*20

 elseif gravity_type=="right" then
  x=-8-index*20
  y=rnd(120)

 elseif gravity_type=="left" then
  x=128+index*20
  y=rnd(120)
 end

 add(obstacles,{x=x,y=y,sprite=4+flr(rnd(3))}) --sprite 4-6

end

function reset_one_obstacle(o)

	--choose new obstacle sprite
	o.sprite=4+flr(rnd(3))

 if gravity_type=="down"
 or gravity_type=="float down" then

  o.x=rnd(120)
  o.y=-8-rnd(40)

 elseif gravity_type=="up" then

  o.x=rnd(120)
  o.y=128+rnd(40)

 elseif gravity_type=="right" then

  o.x=-8-rnd(40)
  o.y=rnd(120)

 elseif gravity_type=="left" then

  o.x=128+rnd(40)
  o.y=rnd(120)

 end

end

function collide(
 ax,ay,aw,ah,
 bx,by,bw,bh
)

 return
  ax<bx+bw and
  ax+aw>bx and
  ay<by+bh and
  ay+ah>by

end


function _draw()

 --cls(1)
	if state=="start" then
		draw_start()
		
 elseif state=="play" then
  draw_game()

 elseif state=="between" then
  draw_between()
 elseif state=="gameover" then
		cls(0)
  print("game over",45,45,8)
  print("rooms: "..(room-1),45,60,7)
  print("press o",48,80,7)

 end
end

function draw_start()
	cls(14)
	--title
	print("hare-icane", 46, 20,1)
	
	--bunny
	spr(0,60,30)
	
	--instr
	print("survive the storm!", 29,45,7)
	print("collect food for energy", 18,62,7)
	print("beware: gravity in the storm", 7, 70,7)
	print(" is strange..", 40, 79,8)
	
	print("a: jump",50,90,1)
 print("b: spend energy",36,100,1)

 print("press a to start",32,118,7)
end

function draw_between()
	cls(14)
	map(0,0,0,0,16,16)
	
	--title
	print("room "..room.." cleared!",
		32,18,0)
		
	--health
	print("health",35, 40, 7)
	for i=1,3 do
		if i<=hp then
			print("♥", 65+(i-1)*10,40,8)
		else
			print("x", 65+(i-1)*10, 40,5)
		end
	end
	
	--coins
	print("energy: "..coins, 35,58,7)
	
	--heal option
	if hp>=3 then
		print("health full:)", 35, 76,15)
	elseif coins>=5 then
		print("b: heal 1 ♥", 28, 76, 7)
		print("cost: 5 energy",28, 84, 6)
	else
		print("not enough energy to heal", 22,76,6)
	end
	
	--continue
	print("a: next room",37,94,7)
end

	
function draw_game()

	draw_background()
 ----------------
 -- world
 ----------------

 -- floor
 if gravity_type=="down" or gravity_type=="float down" then
	 rectfill(0,112,127,127,0)
	elseif gravity_type=="up" then
	 rectfill(0,0,127,7,0)
	elseif gravity_type=="right" then
	 rectfill(120,0,127,127,0)
	elseif gravity_type=="left" then
	 rectfill(0,0,7,127,0)
	end
	
 -- player
 if invincible==0
 or invincible%4<2 then
  local player_sprite=0

		if gravity_type=="up" then
		 player_sprite=16
		elseif gravity_type=="right" then
		 player_sprite=1
		elseif gravity_type=="left" then
		 player_sprite=17
		else
		 player_sprite=0
		end
		
		spr(player_sprite,px-1,py)
 end

 -- obstacle
 for o in all(obstacles) do
	 spr(o.sprite, o.x, o.y)
	end

 -- draw coins
 for c in all(room_coins) do
	 if not c.taken then
	  spr(c.sprite,c.x-4,c.y-4)
	 end
	end


 ----------------
 -- interface
 ----------------

 print("room "..room,2,2,7)
 print("◆: "..gravity_type, 45,10,7)
 
 -- health display
	print("hp",2,10,7)
	
	for i=1,3 do
	 if i<=hp then
	  print("♥",14+(i-1)*8,10,8)
	 else
	  print("x",14+(i-1)*8,10,5)
	 end
	end

 print("energy "..coins,2,18,7)
	
 local seconds=
  flr(room_time+0.99)

 print(
  "time "..seconds,
  90,2,7
 )

end

function draw_background()

 -- lighter storm sky
 cls(1)
 map(16,0,0,0,16,16)

 -- rain streaks
--- line(8,30,4,37,7)
-- line(22,45,18,52,7)
-- line(38,24,34,31,7)
-- line(55,55,51,62,7)
-- line(72,35,68,42,7)
-- line(90,48,86,55,7)
-- line(108,27,104,34,7)
-- line(122,58,118,65,7)
---
	
end










