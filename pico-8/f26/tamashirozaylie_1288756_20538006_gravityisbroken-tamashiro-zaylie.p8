pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
  spawn_x = 8
  spawn_y = 112
  
  p_x = spawn_x
  p_y = spawn_y
  p_w = 7
  p_h = 8
  
  y_state = "idle"
  float_speed = 4.5
  
  on_ceiling = false
  has_won = false
  
  -- tracks current room coordinates on the map grid
  room_x = 0
  room_y = 0
  
  -- track individual level increments within the room loop
  current_level = 1
  
  -- track total deaths throughout the entire run
  deaths = 0
  
  anim_timer = 0
  current_spr = 1
  
  anims = {
    idle  = {1},
    right = {17, 18},
    left  = {19, 18},
    up    = {18, 2, 33, 34, 35},
    down  = {35, 34, 33, 2, 18},
    ceil_right = {49,50,49,35},
    ceil_left = {51,52,51,35},
    ceil_idle = {35}
  }
  
  spikes = {}
  load_level()
end

-- checks if a pixel coordinate is on a solid tile using flag 0
function is_solid(x, y)
  local tile_x = flr(x / 8)
  local tile_y = flr(y / 8)
  local tile = mget(tile_x, tile_y)
  return fget(tile, 0)
end

-- checks all four corners of the player box for solid walls or safe placed objects
function check_wall_collision(x, y)
  if is_solid(x, y) then return true end
  if is_solid(x + p_w - 1, y) then return true end
  if is_solid(x, y + p_h - 1) then return true end
  if is_solid(x + p_w - 1, y + p_h - 1) then return true end
  
  -- checks collision against custom placed block objects that aren't lethal spikes
  for s in all(spikes) do
    if s.sprite != 14 and s.sprite != 15 then
      if x < s.x + s.w and
         x + p_w > s.x and
         y < s.y + s.h and
         y + p_h > s.y then
         return true
      end
    end
  end
  
  return false
end

-- checks if the given coordinate contains goal sprite 10
function is_goal(x, y)
  return mget(flr(x / 8), flr(y / 8)) == 10
end

-- checks if the entire player is overlapping sprite 10 to win
function check_complete_win()
  return is_goal(p_x, p_y) and 
         is_goal(p_x + p_w - 1, p_y) and 
         is_goal(p_x, p_y + p_h - 1) and 
         is_goal(p_x + p_w - 1, p_y + p_h - 1)
end

-- populates spikes dynamically based on active sub-levels
function load_level()
  spikes = {}
  local local_x = room_x * 128
  local local_y = room_y * 128
  
  p_x = local_x + spawn_x
  p_y = local_y + spawn_y
  y_state = "idle"
  on_ceiling = false
  
  -- load different spike sets depending on the logical level number
  if room_x == 0 and room_y == 0 then
    if current_level == 1 then
      add_spike(local_x + 48, local_y + 112, 15)
      add_spike(local_x + 56, local_y + 112, 15)
      add_spike(local_x + 64, local_y + 112, 15)
    elseif current_level == 2 then
    		add_spike(local_x + 16, local_y + 112, 15)
    		add_spike(local_x + 24, local_y + 8, 		14)
    		add_spike(local_x + 32, local_y + 8, 		14)
    		add_spike(local_x + 40, local_y + 112, 15)
    		add_spike(local_x + 48, local_y + 112, 15)
    		add_spike(local_x + 56, local_y + 8, 		14)
    		add_spike(local_x + 64, local_y + 8, 		14)
    		add_spike(local_x + 72, local_y + 112, 15)
    		add_spike(local_x + 80, local_y + 112, 15)
     	add_spike(local_x + 88, local_y + 8, 		14)
    		add_spike(local_x + 96, local_y + 8, 		14)
    elseif current_level == 3 then
      add(spikes, {x = local_x+24, y = local_y+8, w = 8, h = 8, sprite = 13}) 
      add(spikes, {x = local_x+32, y = local_y+8, w = 8, h = 8, sprite = 13}) 
      add(spikes, {x = local_x+56, y = local_y+8, w = 8, h = 8, sprite = 13}) 
      add(spikes, {x = local_x+64, y = local_y+8, w = 8, h = 8, sprite = 13}) 
      add(spikes, {x = local_x+88, y = local_y+8, w = 8, h = 8, sprite = 13}) 
      add(spikes, {x = local_x+96, y = local_y+8, w = 8, h = 8, sprite = 13}) 
      add_spike(local_x +  8, local_y + 8, 14)
      add_spike(local_x + 16, local_y + 8, 14)
      add_spike(local_x + 40, local_y + 8, 14)
      add_spike(local_x + 48, local_y + 8, 14)
      add_spike(local_x + 72, local_y + 8, 14)
      add_spike(local_x + 80, local_y + 8, 14)
      add(spikes, {x = local_x+24, y = local_y+112, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x+32, y = local_y+112, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x+56, y = local_y+112, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x+64, y = local_y+112, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x+88, y = local_y+112, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x+96, y = local_y+112, w = 8, h = 8, sprite = 13})
      add_spike(local_x + 40, local_y + 112, 15)
      add_spike(local_x + 48, local_y + 112, 15)
      add_spike(local_x + 72, local_y + 112, 15)
      add_spike(local_x + 80, local_y + 112, 15)
    elseif current_level == 4 then
      add_spike(local_x + 24, local_y + 112, 15)
      add_spike(local_x + 32, local_y + 112, 15)
      add_spike(local_x + 64, local_y + 112, 15)
      add_spike(local_x + 72, local_y + 112, 15)
      add_spike(local_x + 44, local_y + 8, 14)
      add_spike(local_x + 52, local_y + 8, 14)
      add_spike(local_x + 88, local_y + 8, 14)
      add(spikes, {x = local_x + 44, y = local_y + 64, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 52, y = local_y + 64, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 80, y = local_y + 40, w = 8, h = 8, sprite = 13})
    elseif current_level == 5 then
      for i = 16, 96, 8 do
        add_spike(local_x + i, local_y + 112, 15)
        add_spike(local_x + i, local_y + 8, 14)
      end
      add_spike(local_x + 60, local_y + 80, 15)
      add(spikes, {x = local_x + 32, y = local_y + 16, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 32, y = local_y + 24, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 52, y = local_y + 96, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 60, y = local_y + 96, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 60, y = local_y + 88, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 60, y = local_y + 16, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 68, y = local_y + 96, w = 8, h = 8, sprite = 13})
      add(spikes, {x = local_x + 88, y = local_y + 48, w = 8, h = 8, sprite = 13})
    end
  end
end

-- adds a spike entry with a specified or default sprite id
function add_spike(sx, sy, spr_id)
  local s_id = spr_id or 15
  add(spikes, {x = sx, y = sy, w = 8, h = 8, sprite = s_id}) 
end

-- resets player position and state back to spawn upon death
function kill_player()
  p_x = (room_x * 128) + spawn_x
  p_y = (room_y * 128) + spawn_y
  y_state = "idle"
  on_ceiling = false
  
  -- increment death tracking variable
  deaths += 1
end

function _update()
  anim_timer += 0.2
  
  local active_anim = anims.idle
  if on_ceiling then
    active_anim = anims.ceil_idle
  end
  
  -- handles horizontal movement and direction-based animations
  local dx = 0
  if btn(⬅️) then 
    dx = -1
    if on_ceiling then
      active_anim = anims.ceil_left
    else
      active_anim = anims.left
    end
  elseif btn(➡️) then 
    dx = 1
    if on_ceiling then
      active_anim = anims.ceil_right
    else
      active_anim = engine_anim or anims.right
    end
  end
  
  if dx != 0 then
    if not check_wall_collision(p_x + dx, p_y) then
      p_x += dx
    end
  end
  
  -- handles vertical floating behavior and surface sticking
  local screen_top = room_y * 128
  local screen_bottom = (room_y * 128) + 128 - p_h
  
  if y_state == "idle" then
    if on_ceiling then
      if not check_wall_collision(p_x, p_y - 1) and p_y > screen_top then
        y_state = "floating_down"
        on_ceiling = false
      end
    else
      if not check_wall_collision(p_x, p_y + 1) and p_y < screen_bottom then
        y_state = "floating_down"
      end
    end

    if btnp(⬆️) and p_y > screen_top then
      y_state = "floating_up"
      on_ceiling = false
      anim_timer = 0
    elseif btnp(⬇️) and p_y < screen_bottom then
      y_state = "floating_down"
      on_ceiling = false
      anim_timer = 0
    end
  elseif y_state == "floating_up" then
    active_anim = anims.up
    local hit_obstacle = false
    for step = 1, float_speed do
      if check_wall_collision(p_x, p_y - 1) or (p_y - 1 <= screen_top) then
        hit_obstacle = true
        break
      else
        p_y -= 1
      end
    end
    if hit_obstacle then
      y_state = "idle"
      on_ceiling = true
      anim_timer = 0
    end
  elseif y_state == "floating_down" then
    active_anim = anims.down
    local hit_obstacle = false
    for step = 1, float_speed do
      if check_wall_collision(p_x, p_y + 1) or (p_y + 1 >= screen_bottom) then
        hit_obstacle = true
        break
      else
        p_y += 1
      end
    end
    if hit_obstacle then
      y_state = "idle"
      on_ceiling = false
      anim_timer = 0
    end
  end
  
  -- evaluates bounding box overlap only with lethal spike entities (14 and 15)
  for s in all(spikes) do
    if s.sprite == 14 or s.sprite == 15 then
      if p_x < s.x + s.w and
         p_x + p_w > s.x and
         p_y < s.y + s.h and
         p_y + p_h > s.y then
         kill_player()
      end
    end
  end
  
  -- increments levels, transitioning camera frame coordinates strictly after level 5
  if check_complete_win() then
    current_level += 1
    if current_level == 6 then
      room_x += 1
    end
    load_level()
  end
  
  -- cycles through current animation sequence frames
  local frame = flr(anim_timer % #active_anim) + 1
  current_spr = active_anim[frame]
end

function _draw()
  cls(1)
  
  local cam_x = room_x * 128
  local cam_y = room_y * 128
  camera(cam_x, cam_y)
  map()
  
  -- renders all active spikes and blocks on screen
  for s in all(spikes) do
    spr(s.sprite, s.x, s.y)
  end
  
  -- renders the player entity with current animation frame
  spr(current_spr, p_x, p_y)
  
  -- draw the ui hud inside the very top row of tiles (cam_y + 2)
  print("lvl: "..current_level, cam_x + 4, cam_y + 2, 7)
  print("deaths: "..deaths, cam_x + 80, cam_y + 2, 8)
end

