pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function _init()
    pinit()
    iplat()
    for i=1,8 do
    add(platforms,{
        x=rnd(112),
        y=127-i*16,
        w=16,
        speed=0.3
    })
     end

    ibullet()
    friction=0.95
    menu=true
    gameover=false
end

function _update()	
    if menu then
        if btnp(4,0) then
            menu=false
        end
        return
    end

    if gameover then
        if btnp(4,0) then
            menu=true
            gameover=false
            pinit()
            ibullet()
        end
        return
    end
    
    
    uplat()
    
    moveupplat(player)
    moveupplat(player2)

    playermove()//moves player
    
    handlecd(player)
    
    
    if player.y<-15 then
     sfx(4)
     player.life-=1
     respawn(player)
    end

    if player2.y<-15 then
     sfx(4)
     player2.life-=1
     respawn(player2)
    end
       
    
    
    if(btnp(5,0)and player.shoot_cd<=0) then
       shoot(player) 
       player.shoot_cd=10  
     end
     
     handlecd(player2)
    if(btnp(5,1) and player2.shoot_cd<=0) then
       shoot(player2) 
       player2.shoot_cd=10    
    end
    
    ubullet()
    
     
				
    --if run off screen warp to other side
    if player.x>127 then
     player.x=0
    elseif player.x<0 then
     player.x=127
    end
    if player2.x>127 then
     player2.x=0
    elseif player2.x<0 then
     player2.x=127
    end
    
    if player.life<=0 or player2.life<=0 then
      gameover=true
    end
   end


function _draw()


    if menu then
        cls(1)
        
        print("move left/right: p1:⬅️/➡️ p2:s/f")
        print("lower gravity: p1:⬆️ p2:e")
        print("jump: p1:n p2:tab")
        print("more gravity: p1:⬇️ p2:d")
        print("shoot: p1:m p2:q")

        print("astro bill pvp!",35,35,2)
        print("p1  vs  p2",44,70,6)
        if flr(time()*2)%2==0 then
          print("press n",48,90,7)
         end
        return
    end
     if gameover then
        cls()//clears screen

        print("game over",45,40,8)

        if player.life<=0 then
            print("player 2 wins!",35,55,7)
        else
            print("player 1 wins!",35,55,7)
        end

        print("press n",45,80,7)

        return
    end

    
    
    cls()//clears screen
    
    map()

    dplat()

    spr(player2.face,player2.x,player2.y)
    spr(player.face,player.x,player.y)

    dbullet()
    
    
    

    --display info
    print("p1 life: ".. player.life, 8)
    print("p1 grav: ".. player.gravity, 8)

    local p2life= "p2 life: "..player2.life
    local grav2 = "p2 grav: "..player2.gravity
    local width = print(grav2, 0, -100)
    local width2 = print(p2life, 0, -100)
    
    
    -- print at the upper right (x aligned, y = 2) 
    print(grav2, 127 - width, 6,12)
    print(p2life, 127 - width, 0,12)  
    
       
end
-->8
function pinit()
player={
        x=96,//coordinates
        y=48,
        dx=0,
        dy=0,
        max_dx=2,
        max_dy=3,
        acc=0.5,
        boost=3,
        face=2,
        gravity=0.3,
        jump=2,
        life=3,
        shoot_cd =0,
        invuln=0
    }
    player2={
        x=24, //coordinates
        y=48,
        dx=0,
        dy=0,//acceleration
        max_dx=2,
        max_dy=3,
        acc=0.5,
        boost=3, //boost
        face=5, //sprite face
        gravity=0.3,
        jump=2,
        life=3,
        shoot_cd=0,
        invuln=0
        
    }
end


function spawnpoint(x,y,sprite)

end

function playermove()
    
    local lx =player.x
    local ly = player.y
    local lx2 = player2.x
    local ly2 = player2.y
    
    player.dy+=player.gravity
    player.dx*=friction
				player2.dy+=player2.gravity
				player2.dx*=friction
				
    if (btn(0,0)) then player.dx-=player.acc 
    player.face=2
    end -- left
    if (btn(1,0)) then player.dx+=player.acc 
    player.face=1
    end -- right
    if (btnp(4,0))
     then
      if(player.jump>0) then
      player.dy-=player.boost
      player.jump-=1
      end
     end -- jumps
     
 
				if( btnp(2,0)) then
    -- up = floaty
     if(player.gravity>0.05) then
      player.gravity-=0.025
      player.dy-=0.25
      
     end
    end
    
    if(btnp(3,0) and player.gravity<0.325) then
     player.gravity+=0.025 //fastfall
     player.dy+=2   
    end
 
				
				
				//player 2
				if (btn(0,1)) then player2.dx-=player2.acc 
    player2.face=6
    end -- left2
    if (btn(1,1)) then player2.dx+=player2.acc 
    player2.face=5
    end -- right2
    if (btnp(4,1))
     then
      if(player2.jump>0) then
       player2.dy-=player2.boost
       player2.jump-=1
      end
     end -- jump
				
				
				if( btnp(2,1)) then
    -- up = floaty
     if(player2.gravity>0.05) then
      player2.gravity-=0.025
      player2.dy-=0.25
     end
    end
    
    if(btnp(3,1) and player2.gravity<0.325) then
     player2.gravity+=0.025 //fastfall
     player2.dy+=2   
    end
				
				
    //limit left/right
    player.dx=mid(-player.max_dx,player.dx,player.max_dx)
    player2.dx=mid(-player2.max_dx,player2.dx,player2.max_dx)
   
    //limit fall speed
    if (player.dy>6) then
        player.dy=mid(-player.max_dy,player.dy,player.max_dy)
    end
    
    if (player2.dy>6) then
        player2.dy=mid(-player2.max_dy,player2.dy,player2.max_dy)
    end
    
   
				
 

    -- horizontal movement
    player.x+=player.dx

    if collide(player,0) then
      player.x=lx
      player.dx=0
    end

   -- vertical movement
   player.y+=player.dy

   if collide(player,0) then
     player.y=ly

     if player.dy>0 then
        player.jump=3
     end

     player.dy=0

    else
      platcol(player)
    end

     -- horizontal movement p2
     player2.x+=player2.dx

     if collide(player2,0) then
      player2.x=lx2
      player2.dx=0
     end

     -- vertical movement p2
     player2.y+=player2.dy

     if collide(player2,0) then
       player2.y=ly2

     if player2.dy>0 then
        player2.jump=3
     end

     player2.dy=0

    else
       platcol(player2)
    end
      
      
   function respawn(player)
    if player==player2 then
        player.x=24
        player.y=48
    else
        player.x=96
        player.y=48
    end

    player.dx=0
    player.dy=0
    player.invuln=60
end
    
end
-->8
function collide(player,int) //basically 
  local x1=flr(player.x/8)
  local y1=flr(player.y/8)
  local x2=flr((player.x+7)/8)
  local y2=flr((player.y+7)/8)

  
  local a=fget(mget(x1,y1),int)
  local b=fget(mget(x1,y2),int)
  local c=fget(mget(x2,y2),int)
  local d=fget(mget(x2,y1),int)
  
  if a or b or c or d then
    return true
  else
    return false
  end
  
 end
 
 
 
 
 
 
-->8
function ibullet()
  bull={}

end

function ubullet()
    for b in all(bull) do
        b.x+=b.dx
        

        // bullet hits player 1
       if bullet_hit_player(b,player) and player.invuln<=0 then
          player.life-=1
          sfx(3)
          respawn(player)
          
          del(bull,b)

       elseif bullet_hit_player(b,player2) and player2.invuln<=0 then
           player2.life-=1
           sfx(2)
           respawn(player2)
           
           del(bull,b)
         -- hit a block
       elseif collide(b) then
            del(bull,b)

         

       if player.y<0 then
          sfx(4)
          player.life-=1
          
          respawn(player)
        end

       if player2.y<0 then
         sfx(4)
         player2.life-=1
         
         respawn(player2)
       end
        end
    end
end

function handlecd(player)
   if player.shoot_cd>0 then
    player.shoot_cd-=1
   end
    if player.invuln>0 then
        player.invuln-=1
    end
end

function dbullet()
    for b in all(bull) do
        spr(b.spr,b.x,b.y)
    end
end

function shoot(player)
    local dir=1
    local sprite=59

    if player.face%2==0 then
        dir=-1
    end

    if player==player2 then
        sprite=61
        sfx(5)
    else
       sfx(6)
     end
    
    add(bull,{
        x=player.x+dir*8,
        y=player.y,
        dx=dir*2,
        spr=sprite
    })
    
   
end

function bullet_hit_player(b,p)
    return b.x < p.x+8
    and b.x+8 > p.x
    and b.y < p.y+8
    and b.y+8 > p.y
    
end


-->8
function iplat()
  platforms={}
 
end

function platcol(player)
    for p in all(platforms) do
        if player.dy>=0
        and player.x+7>=p.x
        and player.x<=p.x+p.w
        and player.y+8>=p.y
        and player.y+8<=p.y+4 then

            player.y=p.y-8
            player.dy=0
            player.jump=3
            return true
        end
    end

    return false
end

function aplat()
    add(platforms,{
        x=rnd(120),
        y=127,
        w=16,
        speed=0.3
    })
end

function uplat()
    for p in all(platforms) do
        p.y-=p.speed

        if p.y<-8 then
            del(platforms,p)
            aplat()
        end
    end
end

function dplat()
    for p in all(platforms) do
        rectfill(p.x,p.y,p.x+p.w,p.y+3,15)
    end
end

function moveupplat(player)
    for p in all(platforms) do
        if player.x+7>=p.x
        and player.x<=p.x+p.w
        and abs((player.y+8)-p.y)<2 then

            player.y-=p.speed
        end
    end
end
