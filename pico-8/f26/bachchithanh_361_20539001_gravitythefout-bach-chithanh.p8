pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	gravity_x=0.1
	gravity_y=0.1
	max_levels=1
	level=1
	game_over=false
	alive=true
	reset_player()
end

function reset_player()
	gravity_x=0.1
	gravity_y=0.1
	player={x=61,y=60,w=6,h=8,dx=0,dy=0,flip=false}
end

function _update()
	if game_over then
		if btnp(5) then
			level=1
			game_over=false
			reset_player()
		end
		return
	end

	if btnp(4) then
		gravity_x=-gravity_x
		player.dx=0
	end

	if btnp(5) then
		gravity_y=-gravity_y
		player.dy=0
	end

	player.dx=mid(-1.5,player.dx+gravity_x,1.5)
	move_x()
	player.dy=mid(-1.5,player.dy+gravity_y,1.5)
	move_y()

	if touches_exit() then
		game_over=true
	end

	if touches_dead() then
		game_over=true
		alive=false
	end
end

function move_x()
	player.x+=player.dx
	if player.dx>0 then
		local tx=flr((player.x+player.w-1)/8)
		for ty=flr(player.y/8),flr((player.y+player.h-1)/8) do
			if solid_tile(tx,ty) then
				player.x=tx*8-player.w
			end
		end
	elseif player.dx<0 then
		local tx=flr(player.x/8)
		for ty=flr(player.y/8),flr((player.y+player.h-1)/8) do
			if solid_tile(tx,ty) then
				player.x=(tx+1)*8
			end
		end
	end
end

function move_y()
	player.y+=player.dy
	if player.dy>0 then
		local ty=flr((player.y+player.h-1)/8)
		for tx=flr(player.x/8),flr((player.x+player.w-1)/8) do
			if solid_tile(tx,ty) then
				player.y=ty*8-player.h
				player.dy=0
			end
		end
	elseif player.dy<0 then
		local ty=flr(player.y/8)
		for tx=flr(player.x/8),flr((player.x+player.w-1)/8) do
			if solid_tile(tx,ty) then
				player.y=(ty+1)*8
				player.dy=0
			end
		end
	end
end

function solid_tile(tx,ty)
	return tx<0 or tx>=32 or ty<0 or ty>=32
		or fget(mget(level*32-32+tx,ty),0)
end

function touches_dead(tx,ty)
	return fget(mget(level*32-32+tx,ty),2)
end

function touches_exit()
	for ty=flr(player.y/8),flr((player.y+player.h-1)/8) do
		for tx=flr(player.x/8),flr((player.x+player.w-1)/8) do
			if fget(mget(level*32-32+tx,ty),1) then
				return true
			end
		end
	end
	return false
end

function touches_dead(tx,ty)
	for ty=flr(player.y/8),flr((player.y+player.h-1)/8) do
		for tx=flr(player.x/8),flr((player.x+player.w-1)/8) do
			if fget(mget(level*32-32+tx,ty),2) then
				return true
			end
		end
	end
	return false
end

function _draw()
	cls(0)

    local cam_x=mid(0,player.x-64,128)
	local cam_y=mid(0,player.y-64,128)

	camera(cam_x,cam_y)

    draw_level()
	draw_player()

    camera()

	if game_over then
		rectfill(18,53,109,72,0)
		rect(18,53,109,72,7)

		if alive then 
			print("game over", 64-#("game over")*2, 57, 11)
			print("you won!", 64-#("you won!")*2, 65, 7)
		else
			print("game over", 64-#("game over")*2, 57, 8)
			print("you lost!", 64-#("you lost!")*2, 65, 7)
		end
		print("x: restart", 64-#("x: restart")*2, 75, 12)
	end
end

function draw_level()
	for ty=0,31 do
		for tx=0,31 do
			local tile=mget(level*32-32+tx,ty)
			if tile>0 then
				spr(tile,tx*8,ty*8)
			end
		end
	end
end

function draw_player()
	spr(0,player.x,player.y,1,1,gravity_x>0,gravity_y<0)
end
